;;; emacs-agent-status-test.el --- Offline global status tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-agent-status)
(require 'emacs-agent-compact)

(defmacro emacs-agent-status-test--with-mode (&rest body)
  "Run BODY with an isolated registry and fresh status mode."
  (declare (indent 0) (debug t))
  `(let ((emacs-agent-session--registry (make-hash-table :test #'equal))
         (emacs-agent-session-event-functions nil)
         (emacs-agent-session-state-functions nil)
         (emacs-agent-status-mode nil)
         (emacs-agent-status-prefix "AI")
         (emacs-agent-status-labels
          '((waiting . "wait") (responding . "reply") (eval_elisp . "eval")
            (compacting . "compact") (paused . "pause") (queued . "q")))
         (emacs-agent-status--display nil)
         (emacs-agent-status--original-scalar nil)
         (global-mode-string nil))
     (unwind-protect
         (progn (emacs-agent-status-mode 1) ,@body)
       (emacs-agent-status-mode -1))))

(defun emacs-agent-status-test--session (id &optional status)
  "Register a fresh session ID, optionally owning a run with STATUS."
  (let ((session (make-emacs-agent-session :id id)))
    (when status
      (setf (emacs-agent-session-active-run session)
            (make-emacs-agent-run :id (concat id "-run") :session session :status status)))
    (puthash id session emacs-agent-session--registry)
    session))

(ert-deftest emacs-agent-status-preserves-global-mode-string ()
  (dolist (original '(nil "existing" existing ("text" existing nil)))
    (emacs-agent-status-test--with-mode
      (emacs-agent-status-mode -1)
      (setq global-mode-string (copy-tree original))
      (let ((format-before mode-line-format))
        (emacs-agent-status-mode 1)
        (emacs-agent-status-mode 1)
        (should (= 1 (cl-count 'emacs-agent-status--display global-mode-string)))
        (should (memq #'emacs-agent-status-update emacs-agent-session-event-functions))
        (should (memq #'emacs-agent-status-update emacs-agent-session-state-functions))
        (emacs-agent-status-mode -1)
        (should (equal global-mode-string original))
        (should (eq mode-line-format format-before))
        (should-not (memq #'emacs-agent-status-update emacs-agent-session-event-functions))
        (should-not (memq #'emacs-agent-status-update emacs-agent-session-state-functions))))))

(ert-deftest emacs-agent-status-preserves-other-mode-additions ()
  (emacs-agent-status-test--with-mode
    (setq global-mode-string (append global-mode-string '("new" other nil)))
    (emacs-agent-status-mode -1)
    (should (equal global-mode-string '("new" other nil)))))

(ert-deftest emacs-agent-status-lifecycle-and-terminal-ownership ()
  (emacs-agent-status-test--with-mode
    (should-not emacs-agent-status--display)
    (let* ((session (emacs-agent-status-test--session "one" 'requesting))
           (run (emacs-agent-session-active-run session)))
      (dolist (pair '((requesting . "wait") (streaming . "reply")
                      (tool-running . "eval") (paused . "pause")
                      (requesting . "wait")))
        (setf (emacs-agent-run-status run) (car pair))
        (run-hook-with-args 'emacs-agent-session-state-functions session)
        (should (equal emacs-agent-status--display (concat " AI:" (cdr pair) " "))))
      (dolist (status '(completed failed cancelled))
        (setf (emacs-agent-run-status run) status)
        ;; Native terminal hooks run while the active-run slot is still set.
        (emacs-agent-session-record run status "terminal")
        (should (eq run (emacs-agent-session-active-run session)))
        (should-not emacs-agent-status--display)))))

(ert-deftest emacs-agent-status-aggregate-and-positive-queue-only ()
  (emacs-agent-status-test--with-mode
    (let ((one (emacs-agent-status-test--session "one" 'streaming))
          (two (emacs-agent-status-test--session "two" 'streaming)))
      (emacs-agent-status-test--session "three" 'paused)
      (setf (emacs-agent-session-pending-runs one)
            (list (make-emacs-agent-run :session one)
                  (make-emacs-agent-run :session one :status 'completed))
            (emacs-agent-session-pending-runs two)
            (list (make-emacs-agent-run :session two)))
      (emacs-agent-status-update)
      (should (equal emacs-agent-status--display " AI:reply×2 pause q:2 "))
      (setf (emacs-agent-session-pending-runs one) nil
            (emacs-agent-session-pending-runs two) nil)
      (emacs-agent-status-update)
      (should (equal emacs-agent-status--display " AI:reply×2 pause ")))))

(ert-deftest emacs-agent-status-compaction-terminal-before-removal ()
  (emacs-agent-status-test--with-mode
    (let* ((session (emacs-agent-status-test--session "one"))
           (run (make-emacs-agent-run :session session))
           (job (make-emacs-agent-compact-job :run run)))
      (setf (emacs-agent-session-compaction-job session) job)
      (dolist (state '(requesting committing))
        (setf (emacs-agent-compact-job-state job) state)
        (emacs-agent-session-record run 'compacting "summary")
        (should (equal emacs-agent-status--display " AI:compact ")))
      (dolist (state '(completed failed cancelled))
        (setf (emacs-agent-compact-job-state job) state)
        (emacs-agent-session-record run 'usage-total nil)
        (should (eq job (emacs-agent-session-compaction-job session)))
        (should-not emacs-agent-status--display))
      (let ((owner (make-emacs-agent-run :session session :status 'requesting)))
        (setf (emacs-agent-session-active-run session) owner
              (emacs-agent-compact-job-state job) 'requesting)
        (emacs-agent-status-update)
        (should (equal emacs-agent-status--display " AI:compact "))
        (setf (emacs-agent-compact-job-state job) 'completed)
        (emacs-agent-status-update)
        (should (equal emacs-agent-status--display " AI:wait "))))))

(ert-deftest emacs-agent-status-registration-identity-and-archives ()
  (emacs-agent-status-test--with-mode
    (let* ((old (emacs-agent-status-test--session "same" 'streaming))
           (archive (make-emacs-agent-session :id "archive"))
           (replacement (emacs-agent-status-test--session "same" 'paused)))
      (emacs-agent-status-update old)
      (emacs-agent-status-update archive)
      (should-not emacs-agent-status--display)
      (emacs-agent-status-update replacement)
      (should (equal emacs-agent-status--display " AI:pause "))
      ;; A copied object with the same ID has no live authority.
      (setf (emacs-agent-run-status (emacs-agent-session-active-run old)) 'tool-running)
      (emacs-agent-status-update old)
      (should (equal emacs-agent-status--display " AI:pause "))
      (remhash "same" emacs-agent-session--registry)
      (emacs-agent-status-update)
      (should-not emacs-agent-status--display))))

(ert-deftest emacs-agent-status-streaming-cache-and-no-history-access ()
  (emacs-agent-status-test--with-mode
    (let* ((session (emacs-agent-status-test--session "one" 'streaming))
           (run (emacs-agent-session-active-run session))
           (updates 0))
      (cl-letf (((symbol-function 'force-mode-line-update)
                 (lambda (&optional _all) (cl-incf updates)))
                ((symbol-function 'emacs-agent-session-events)
                 (lambda (&rest _) (error "History read")))
                ((symbol-function 'emacs-agent-session-messages)
                 (lambda (&rest _) (error "History read")))
                ((symbol-function 'emacs-agent-session-inputs)
                 (lambda (&rest _) (error "Historical inputs read"))))
        (emacs-agent-status-update session)
        (should (= updates 1))
        (let ((cached emacs-agent-status--display))
          (dotimes (_ 20)
            (run-hook-with-args 'emacs-agent-session-event-functions session
                                '(:type assistant :payload "token")))
          (should (eq cached emacs-agent-status--display))
          (should (= updates 1))
          (should (stringp (symbol-value (car global-mode-string))))
          (setf (emacs-agent-run-status run) 'requesting)
          (run-hook-with-args 'emacs-agent-session-state-functions session)
          (should (= updates 2))
          (should (equal emacs-agent-status--display " AI:wait ")))))))

(ert-deftest emacs-agent-status-enable-snapshots-live-runtime ()
  (emacs-agent-status-test--with-mode
    (emacs-agent-status-mode -1)
    (emacs-agent-status-test--session "already-live" 'tool-running)
    (emacs-agent-status-mode 1)
    (should (equal emacs-agent-status--display " AI:eval "))
    (emacs-agent-status-mode -1)
    (emacs-agent-status-update)
    (should-not emacs-agent-status--display)))

(ert-deftest emacs-agent-status-native-tool-transition-does-not-stay-executing ()
  (emacs-agent-test-adapter
    (emacs-agent-status-test--with-mode
      (with-temp-buffer
        (let ((run (emacs-agent-test--submit "status fixture")) during-tool)
          (should (equal emacs-agent-status--display " AI:wait "))
          (emacs-agent-gptel--callback run "answer" nil)
          (should (equal emacs-agent-status--display " AI:reply "))
          (cl-letf (((symbol-function 'emacs-agent-eval)
                     (lambda (&rest _)
                       (setq during-tool emacs-agent-status--display)
                       "=> 2")))
            (emacs-agent-test--calls run '(("status-tool" "(+ 1 1)"))))
          (should (equal during-tool " AI:eval "))
          (should (equal emacs-agent-status--display " AI:wait "))
          (emacs-agent-test--complete run "done")
          (should-not emacs-agent-status--display))))))

(ert-deftest emacs-agent-status-text-deltas-do-not-rescan-archives ()
  (emacs-agent-status-test--with-mode
    (let* ((session (emacs-agent-status-test--session "stream" 'streaming))
           (run (emacs-agent-session-active-run session)))
      (emacs-agent-status-update)
      (cl-letf (((symbol-function 'emacs-agent-status--render)
                 (lambda () (ert-fail "Text delta scanned registry"))))
        (dolist (type '(assistant reasoning usage context-usage))
          (emacs-agent-session-record run type "delta")))
      (should (equal emacs-agent-status--display " AI:reply ")))))

(ert-deftest emacs-agent-runtime-observer-errors-do-not-fail-run ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let ((emacs-agent-session-state-functions
             (list (lambda (&rest _) (error "Broken UI observer"))))
            (run (emacs-agent-test--submit "observer fixture")))
        (emacs-agent-gptel--callback run "answer" nil)
        (emacs-agent-gptel--callback run t nil)
        (should (eq (emacs-agent-run-status run) 'requesting))
        (emacs-agent-test--complete run "done")
        (should (eq (emacs-agent-run-status run) 'completed))))))

(ert-deftest emacs-agent-runtime-observer-cancel-prevents-wait-transport ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((run (emacs-agent-test--submit "cancel at UI notification"))
             (session (emacs-agent-run-session run))
             (fsm (gptel-make-fsm)) launched
             (emacs-agent-session-state-functions
              (list (lambda (changed)
                      (when (eq (emacs-agent-session-active-run changed) run)
                        (emacs-agent-gptel-cancel changed))))))
        (setf (gptel-fsm-info fsm) '(:history (INIT)))
        (emacs-agent-gptel--wait run (list (lambda (&rest _) (setq launched t))) fsm)
        (should-not launched)
        (should-not (emacs-agent-session-active-run session))
        (should (eq (emacs-agent-run-status run) 'cancelled))))))

(ert-deftest emacs-agent-status-customize-refreshes-prefix-and-labels ()
  (emacs-agent-status-test--with-mode
    (let* ((session (emacs-agent-status-test--session "custom" 'requesting))
           (run (emacs-agent-session-active-run session)))
      (emacs-agent-status-update)
      (should (equal emacs-agent-status--display " AI:wait "))
      (funcall (get 'emacs-agent-status-labels 'custom-set)
               'emacs-agent-status-labels '((waiting . "ждать")))
      (should (equal emacs-agent-status--display " AI:ждать "))
      (funcall (get 'emacs-agent-status-prefix 'custom-set)
               'emacs-agent-status-prefix "Agent")
      (should (equal emacs-agent-status--display " Agent:ждать "))
      (funcall (get 'emacs-agent-status-prefix 'custom-set)
               'emacs-agent-status-prefix "")
      (should (equal emacs-agent-status--display " ждать "))
      (setf (emacs-agent-run-status run) 'completed)
      (emacs-agent-status-update session)
      (should-not emacs-agent-status--display))))

(ert-deftest emacs-agent-status-custom-label-counts-and-fallback ()
  (emacs-agent-status-test--with-mode
    (let ((session (emacs-agent-status-test--session "one" 'requesting))
          (emacs-agent-status-prefix "🤖")
          (emacs-agent-status-labels '((waiting . "50%") (queued . "оч"))))
      (emacs-agent-status-test--session "two" 'requesting)
      (setf (emacs-agent-session-pending-runs session)
            (list (make-emacs-agent-run :session session)))
      (emacs-agent-status-update)
      (should (equal emacs-agent-status--display " 🤖:50%×2 оч:1 "))
      (setq emacs-agent-status-labels nil)
      (emacs-agent-status-update)
      (should (equal emacs-agent-status--display " 🤖:waiting×2 queued:1 ")))))

(provide 'emacs-agent-status-test)

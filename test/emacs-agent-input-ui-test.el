;;; emacs-agent-input-ui-test.el --- Offline pending UI tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-agent)
;; Loaded after emacs-agent-gptel-test.el, which supplies the offline fixture.

(ert-deftest emacs-agent-input-ui-steer-captures-before-prompt ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (insert "before")
      (let* ((target (emacs-agent-test--submit "work"))
             (session (emacs-agent-run-session target))
             (source (current-buffer))
             (snapshot (emacs-agent-context-capture nil)))
        (setf (emacs-agent-run-status target) 'paused)
        (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                  ((symbol-function 'read-from-minibuffer)
                   (lambda (&rest _) (erase-buffer) (insert "after") "clarify\nfully")))
          (let ((input (emacs-agent-steer)))
            (should (eq (emacs-agent-input-target input) target))
            (should (eq (emacs-agent-run-source-buffer (emacs-agent-input-run input)) source))
            (should (equal (emacs-agent-run-editor-context (emacs-agent-input-run input)) snapshot))
            (should (eq (emacs-agent-input-state input) 'queued))
            (should (eq (emacs-agent-session-active-run session) target))))))))

(ert-deftest emacs-agent-input-ui-steer-target-finishes-or-cancels-during-prompt ()
  (dolist (finish '(completed cancelled))
    (emacs-agent-test-adapter
      (with-temp-buffer
        (let* ((target (emacs-agent-test--submit "work"))
               (session (emacs-agent-run-session target))
               (next (emacs-agent-test--submit "next")))
          (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                    ((symbol-function 'read-from-minibuffer)
                     (lambda (&rest _)
                       (if (eq finish 'completed)
                           (emacs-agent-test--complete target "done")
                         (emacs-agent-gptel-cancel session))
                       "late clarification")))
            (let ((input (emacs-agent-steer)))
              (should (eq (emacs-agent-input-target input) target))
              (should (eq (emacs-agent-session-active-run session) next))
              (should (eq (emacs-agent-input-kind input)
                          (if (eq finish 'completed) 'ask 'steer)))
              (should (eq (emacs-agent-input-state input)
                          (if (eq finish 'completed) 'queued 'withdrawn))))))))))

(ert-deftest emacs-agent-input-ui-no-active-blank-and-quit ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                ((symbol-function 'read-from-minibuffer) (lambda (&rest _) (ert-fail "Unexpected prompt"))))
        (should-error (emacs-agent-steer) :type 'user-error))
      (let* ((target (emacs-agent-test--submit "work"))
             (session (emacs-agent-run-session target)))
        (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                  ((symbol-function 'read-from-minibuffer) (lambda (&rest _) " \n ")))
          (should-not (emacs-agent-steer)))
        (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                  ((symbol-function 'read-from-minibuffer) (lambda (&rest _) (signal 'quit nil))))
          (should (eq (condition-case nil (emacs-agent-steer) (quit 'quit)) 'quit)))
        (should-not (emacs-agent-input-for-run target))
        (should (eq (emacs-agent-session-active-run session) target))))))

(ert-deftest emacs-agent-input-ui-edit-ask-withdraws-first-and-preserves-snapshots ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (emacs-agent-test--submit "active")
      (let* ((run (emacs-agent-test--submit "original\nsecond line"))
             (session (emacs-agent-run-session run))
             (input (emacs-agent-run-input run))
             (context (emacs-agent-run-editor-context run))
             (instructions (emacs-agent-run-instructions run))
             (backend (emacs-agent-run-backend run))
             (last (emacs-agent-test--submit "last")))
        (cl-letf (((symbol-function 'read-from-minibuffer)
                   (lambda (_prompt initial &rest _)
                     (should (equal initial "original\nsecond line"))
                     (should (eq (emacs-agent-input-state input) 'withdrawn))
                     (should-not (memq run (emacs-agent-session-pending-runs session)))
                     (signal 'quit nil))))
          (should (eq (condition-case nil (emacs-agent-pending-edit input) (quit 'quit)) 'quit)))
        (should (eq (emacs-agent-input-state input) 'withdrawn))
        (should (equal (emacs-agent-run-user-text run) "original\nsecond line"))
        (cl-letf (((symbol-function 'read-from-minibuffer) (lambda (&rest _) "edited")))
          (emacs-agent-pending-edit input))
        (should (equal (emacs-agent-session-pending-runs session) (list last run)))
        (should (eq (emacs-agent-run-editor-context run) context))
        (should (eq (emacs-agent-run-instructions run) instructions))
        (should (eq (emacs-agent-run-backend run) backend))
        (should (equal (emacs-agent-run-user-text run) "edited"))))))

(ert-deftest emacs-agent-input-ui-restored-rebinding-is-explicit-and-safe ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((target (emacs-agent-test--submit "active"))
             (session (emacs-agent-run-session target))
             (input (emacs-agent-input-queue-steer target "recover" nil (current-buffer) nil))
             (restored (emacs-agent-input-restore (emacs-agent-input-data input) session))
             (run (emacs-agent-input-run restored))
             (source (current-buffer))
             (gptel--known-backends (list (cons "agent-offline" gptel-backend))))
        (setf (emacs-agent-run-source-buffer run) nil)
        (cl-letf (((symbol-function 'read-buffer)
                   (lambda (_prompt _default _match predicate)
                     (should (funcall predicate (buffer-name source)))
                     (buffer-name source)))
                  ((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "Known backend"))))
          (emacs-agent-pending--rebind restored))
        (should (eq (emacs-agent-run-source-buffer run) source))
        (should (eq (emacs-agent-run-backend run) gptel-backend))
        (setf (emacs-agent-run-backend run) nil
              (emacs-agent-input-backend-name restored) "missing")
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "agent-offline")))
          (emacs-agent-pending--rebind restored))
        (let ((journal (generate-new-buffer " *input-ui-journal*")))
          (unwind-protect
              (progn
                (with-current-buffer journal (setq-local emacs-agent-session--owner session))
                (setf (emacs-agent-run-source-buffer run) nil)
                (dolist (bad (list journal (window-buffer (minibuffer-window))))
                  (cl-letf (((symbol-function 'read-buffer) (lambda (&rest _) (buffer-name bad))))
                    (should-error (emacs-agent-pending--rebind restored) :type 'user-error))))
            (kill-buffer journal)))))))

(ert-deftest emacs-agent-input-ui-pending-owner-and-full-text ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((target (emacs-agent-test--submit "active"))
             (session (emacs-agent-run-session target))
             (text (concat "first\n" (make-string 2000 ?x)))
             (input (emacs-agent-input-queue-steer target text nil (current-buffer) nil))
             view detail)
        (unwind-protect
            (cl-letf (((symbol-function 'emacs-agent--current-session) (lambda () session))
                      ((symbol-function 'display-buffer) #'ignore))
              (setq view (emacs-agent-pending))
              (with-current-buffer view
                (should (eq emacs-agent-session--owner session))
                (should (equal (caar tabulated-list-entries) (emacs-agent-input-id input)))
                (should (equal (aref (cadar tabulated-list-entries) 2) "first"))
                (setq detail (emacs-agent-pending-show input)))
              (with-current-buffer detail
                (should buffer-read-only)
                (should (equal (buffer-string) text))))
          (when view (kill-buffer view))
          (when detail (kill-buffer detail)))))))

(ert-deftest emacs-agent-input-ui-live-edit-and-cancelled-recovery ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((target (emacs-agent-test--submit "active"))
             (session (emacs-agent-run-session target))
             (input (emacs-agent-input-queue-steer target "original" nil (current-buffer) nil)))
        (cl-letf (((symbol-function 'read-from-minibuffer)
                   (lambda (&rest _)
                     (should-not (emacs-agent-input-for-run target))
                     "edited steer")))
          (emacs-agent-pending-edit input))
        (should (equal (emacs-agent-input-for-run target) (list input)))
        (should-not (emacs-agent-session-pending-runs session))
        (emacs-agent-gptel-cancel session)
        (should (eq (emacs-agent-input-state input) 'withdrawn))
        (emacs-agent-pending-recover input)
        (push (emacs-agent-input-run input) emacs-agent-test--runs)
        (should (eq (emacs-agent-input-kind input) 'ask))
        (should (eq (emacs-agent-session-active-run session) (emacs-agent-input-run input)))
        (should (equal (emacs-agent-run-user-text (emacs-agent-input-run input)) "edited steer"))))))

(ert-deftest emacs-agent-input-ui-forget-requires-withdrawal-and-confirmation ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((target (emacs-agent-test--submit "active"))
             (input (emacs-agent-input-queue-steer target "pending" nil (current-buffer) nil))
             forgotten)
        (cl-letf (((symbol-function 'emacs-agent-input-forget)
                   (lambda (item) (setq forgotten item)))
                  ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
          (should-error (emacs-agent-pending-forget input) :type 'user-error)
          (should-not forgotten)
          (emacs-agent-pending-withdraw input)
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
            (emacs-agent-pending-forget input))
          (should-not forgotten)
          (emacs-agent-pending-forget input)
          (should (eq forgotten input)))))))

(provide 'emacs-agent-input-ui-test)

;;; emacs-agent-process-test.el --- Synchronous process helper -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'emacs-agent-helpers)

(defmacro emacs-agent-process-test--directory (&rest body)
  "Run BODY in a disposable local directory, including private output storage."
  (declare (indent 0) (debug t))
  `(let* ((root (make-temp-file "agent-process-" t))
          (default-directory (file-name-as-directory root))
          (emacs-agent-data-directory (expand-file-name "data/" root)))
     (unwind-protect (progn ,@body) (delete-directory root t))))

(defun emacs-agent-process-test--sh ()
  "Find a real POSIX shell independently of the user's shell."
  (or (executable-find "sh") (ert-skip "POSIX sh unavailable")))

(defun emacs-agent-process-test--state ()
  "Capture source state, including inaccessible text and undo identity separately."
  (list (save-restriction (widen) (buffer-string))
        (point) (mark t) mark-active (point-min) (point-max)
        (buffer-modified-p) (buffer-chars-modified-tick) default-directory))

(ert-deftest emacs-agent-process-real-stderr-status-and-empty-output ()
  (emacs-agent-process-test--directory
    (let ((sh (emacs-agent-process-test--sh)))
      (dolist (case '(("printf OUT; printf ERR >&2; exit 7" "OUTERR" 7)
                      ("exit 0" "" 0) ("exit 19" "" 19)))
        (let ((result (emacs-agent-run-process sh (list "-c" (car case)))))
          (should (equal (plist-get result :output) (nth 1 case)))
          (should (equal (last result 2) (list :exit (nth 2 case))))
          (should (equal (plist-get result :directory) default-directory))
          (should (equal (cl-loop for (key _value) on result by #'cddr collect key)
                         '(:output :directory :command :exit))))))))

(ert-deftest emacs-agent-process-real-literal-argv-list-and-vector ()
  (emacs-agent-process-test--directory
    (let* ((sh (emacs-agent-process-test--sh))
           (literal '("space here" "\"double\" 'single'" "λ界" "$(touch INJECTED)"
                      "; touch INJECTED" "*" "$HOME" "back\\slash" "" "line\nbreak"))
           (args (append '("-c" "printf '<%s>\\n' \"$@\"" "argv0") literal))
           (expected (mapconcat (lambda (s) (concat "<" s ">\n")) literal "")))
      (dolist (argv (list args (vconcat args)))
        (let ((result (emacs-agent-run-process sh argv)))
          (should (equal (plist-get result :output) expected))
          (should (equal (plist-get result :command) (cons sh args)))
          (should (= (plist-get result :exit) 0))))
      (should-not (file-exists-p "INJECTED")))))

(ert-deftest emacs-agent-process-real-cwd-and-relative-executable ()
  (emacs-agent-process-test--directory
    (let ((sh (emacs-agent-process-test--sh)))
      (make-directory "work/subdir" t)
      (with-temp-file "work/child"
        (insert "#!" sh "\nprintf '%s\\n' \"$PWD\"; printf '%s' \"$1\"\n"))
      (set-file-modes "work/child" #o700)
      (dolist (program '("./child" "subdir/../child"))
        (let ((result (emacs-agent-run-process program ["literal"] :directory "work/subdir/..")))
          (should (equal (plist-get result :directory) (expand-file-name "work/")))
          (should (equal (plist-get result :command)
                         (list (expand-file-name "work/child") "literal")))
          (should (equal (plist-get result :output)
                         (concat (directory-file-name (expand-file-name "work/")) "\nliteral")))
          (should (= (plist-get result :exit) 0)))))))

(ert-deftest emacs-agent-process-real-bare-name-native-path ()
  (emacs-agent-process-test--directory
    (let* ((sh (emacs-agent-process-test--sh))
           (exec-path (list (file-name-directory sh)))
           (shell-file-name "/deliberately/not/a/shell")
           (result (emacs-agent-run-process "sh" '("-c" "printf native"))))
      (should (equal (plist-get result :command) '("sh" "-c" "printf native")))
      (should (equal (plist-get result :output) "native")))))

(ert-deftest emacs-agent-process-repetition-isolates-output-and-kills-buffers ()
  (emacs-agent-process-test--directory
    (let ((sh (emacs-agent-process-test--sh))
          (process (symbol-function 'process-file)) buffers)
      (cl-letf (((symbol-function 'process-file)
                 (lambda (&rest args)
                   (push (current-buffer) buffers)
                   (apply process args))))
        (dolist (script '("printf first" "printf second >&2" "exit 0" "printf first"))
          (let ((result (emacs-agent-run-process sh (list "-c" script))))
            (should (equal (plist-get result :output)
                           (cond ((equal script "printf first") "first")
                                 ((equal script "exit 0") "") (t "second")))))))
      (should (= (length (delete-dups (copy-sequence buffers))) 4))
      (should (cl-every (lambda (buffer) (not (buffer-live-p buffer))) buffers)))))

(ert-deftest emacs-agent-process-process-file-call-and-plain-copies ()
  (emacs-agent-process-test--directory
    (let* ((program (propertize "bare-tool" 'face 'bold))
           (arg (propertize "literal λ" 'face 'italic))
           (args (vector arg))
           (dir (propertize "sub/.." 'face 'bold))
           output-buffer)
      (cl-letf (((symbol-function 'process-file)
                 (lambda (actual infile destination display &rest argv)
                   (setq output-buffer (current-buffer))
                   (should-not (eq (current-buffer) (get-buffer "*scratch*")))
                   (should (equal actual "bare-tool"))
                   (should-not (eq actual program))
                   (should-not (text-properties-at 0 actual))
                   (should-not infile)
                   (should (equal destination '(t t)))
                   (should-not display)
                   (should (equal argv '("literal λ")))
                   (should-not (eq (car argv) arg))
                   (should-not (text-properties-at 0 (car argv)))
                   (should (equal default-directory (file-name-as-directory root)))
                   (should-not (text-properties-at 0 default-directory))
                   (insert (propertize "combined" 'face 'bold))
                   "terminated")))
        (let ((result (emacs-agent-run-process program args :directory dir)))
          (should (equal result (list :output "combined" :directory default-directory
                                      :command '("bare-tool" "literal λ") :exit "terminated")))
          (should-not (text-properties-at 0 (plist-get result :output)))))
      (should-not (buffer-live-p output-buffer))
      (should (eq (get-text-property 0 'face arg) 'italic))
      (should (eq (aref args 0) arg)))))

(ert-deftest emacs-agent-process-path-normalization-before-launch ()
  (emacs-agent-process-test--directory
    (cl-letf (((symbol-function 'process-file)
               (lambda (program &rest _)
                 (should (equal default-directory (expand-file-name "work/" root)))
                 (should (equal program (expand-file-name "work/tool" root)))
                 0)))
      (dolist (program (list "./tool" "sub/../tool" (expand-file-name "work/tool")))
        (emacs-agent-run-process program nil :directory "work")))))

(ert-deftest emacs-agent-process-invalid-input-never-launches ()
  (let ((cycle (list "loop")) (calls 0))
    (setcdr cycle cycle)
    (cl-letf (((symbol-function 'process-file) (lambda (&rest _) (cl-incf calls) 0)))
      (dolist (program '(nil 7 ""))
        (should-error (emacs-agent-run-process program nil)))
      (dolist (args (list "string" 7 '("a" . "b") '("a" 3) ["a" nil] cycle))
        (should-error (emacs-agent-run-process "tool" args)))
      (should-error (emacs-agent-run-process "tool" nil :directory nil))
      (should-error (emacs-agent-run-process "tool" nil :directory 42))
      (should (zerop calls)))))

(ert-deftest emacs-agent-process-empty-argv-list-and-vector ()
  (cl-letf (((symbol-function 'process-file)
             (lambda (_program _in _dest _display &rest args)
               (should-not args) 0)))
    (dolist (args '(nil []))
      (should (equal (plist-get (emacs-agent-run-process "tool" args) :command) '("tool"))))))

(ert-deftest emacs-agent-process-errors-quits-and-source-preservation ()
  (emacs-agent-process-test--directory
    (with-temp-buffer
      (buffer-enable-undo)
      (insert "before\nunsaved source\nafter\n")
      (narrow-to-region 8 22)
      (goto-char 10) (set-mark 16) (setq mark-active t)
      (dolist (condition '(nil (file-missing "launch failed") (quit)))
        (let ((source (current-buffer))
              (state (emacs-agent-process-test--state))
              (undo buffer-undo-list) private)
          (cl-letf (((symbol-function 'process-file)
                     (lambda (&rest _)
                       (setq private (current-buffer))
                       (should-not (eq private source))
                       (insert "partial process output")
                       (if condition (signal (car condition) (cdr condition)) 0)))
                    ((symbol-function 'save-buffer) (lambda (&rest _) (ert-fail "Unexpected save")))
                    ((symbol-function 'do-auto-save) (lambda (&rest _) (ert-fail "Unexpected autosave"))))
            (if condition
                (should (equal (condition-case caught
                                   (emacs-agent-run-process "tool" nil)
                                 ((error quit) caught))
                               condition))
              (should (equal (plist-get (emacs-agent-run-process "tool" nil) :output)
                             "partial process output"))))
          (should (eq source (current-buffer)))
          (should (equal state (emacs-agent-process-test--state)))
          (should (eq undo buffer-undo-list))
          (should-not (buffer-live-p private)))))))

(ert-deftest emacs-agent-process-real-launch-error-propagates ()
  (emacs-agent-process-test--directory
    (let ((state (emacs-agent-process-test--state)))
      (should-error (emacs-agent-run-process "./nonexistent-program" nil) :type 'file-missing)
      (should (equal state (emacs-agent-process-test--state))))))

(ert-deftest emacs-agent-process-real-source-preserved-and-generated-file-retained ()
  (emacs-agent-process-test--directory
    (let ((sh (emacs-agent-process-test--sh)))
      (with-temp-buffer
        (buffer-enable-undo)
        (insert "unsaved live buffer\n")
        (setq buffer-file-name (expand-file-name "not-saved"))
        (narrow-to-region 2 12) (goto-char 4) (set-mark 8)
        (let ((state (emacs-agent-process-test--state)) (undo buffer-undo-list))
          (should (= (plist-get (emacs-agent-run-process
                                sh '("-c" "printf artifact > generated; exit 3")) :exit) 3))
          (should (file-exists-p "generated"))
          (should-not (file-exists-p "not-saved"))
          (should (equal state (emacs-agent-process-test--state)))
          (should (eq undo buffer-undo-list)))))))

(ert-deftest emacs-agent-process-remote-paths-without-connections ()
  "Mock remote syntax operations and launch; never invoke a TRAMP handler."
  (let* ((prefix "/ssh:tester@host:")
         (remote-dir (concat prefix "/work/"))
         (expand (symbol-function 'expand-file-name))
         calls)
    (cl-letf (((symbol-function 'file-remote-p)
               (lambda (name &rest _) (and (string-prefix-p prefix name) prefix)))
              ((symbol-function 'file-local-name)
               (lambda (name) (if (string-prefix-p prefix name)
                                  (substring name (length prefix)) name)))
              ((symbol-function 'expand-file-name)
               (lambda (name &optional directory)
                 (cond ((string-prefix-p prefix name)
                        (concat prefix (funcall expand (substring name (length prefix)) "/")))
                       ((and directory (string-prefix-p prefix directory))
                        (concat prefix (funcall expand name (substring directory (length prefix)))))
                       (t (funcall expand name directory)))))
              ((symbol-function 'process-file)
               (lambda (program infile destination display &rest args)
                 (push (list program default-directory infile destination display args) calls)
                 0)))
      (dolist (pair `(("tool" . "tool") ("./tool" . "/work/tool")
                      ("sub/../tool" . "/work/tool")
                      (,(concat prefix "/work/tool") . "/work/tool")))
        (let ((result (emacs-agent-run-process (car pair) ["arg"] :directory remote-dir)))
          (should (equal (plist-get result :directory) remote-dir))
          (should (equal (plist-get result :command) (list (cdr pair) "arg")))
          (should (equal (car calls) (list (cdr pair) remote-dir nil '(t t) nil '("arg"))))))
      (let ((count (length calls)))
        (should-error (emacs-agent-run-process (concat prefix "/tool") nil :directory "/tmp/"))
        (should-error (emacs-agent-run-process (concat prefix "/tool") nil
                                               :directory "/ssh:tester@other:/work/"))
        (should (= count (length calls)))))))

(ert-deftest emacs-agent-process-f3-tail-keeps-status-private-artifact-no-repeat ()
  (emacs-agent-process-test--directory
    (let ((sh (emacs-agent-process-test--sh))
          (emacs-agent-eval-output-limit 700)
          (process (symbol-function 'process-file)) (calls 0))
      (cl-letf (((symbol-function 'process-file)
                 (lambda (&rest args) (cl-incf calls) (apply process args))))
        (let* ((expression (format "(princ (make-string 2000 ?N)) (emacs-agent-run-process %S '(\"-c\" \"printf process-output; printf err >&2; exit 23\"))" sh))
               (wire (emacs-agent-eval expression)) file full)
          (should (= calls 1))
          (should (<= (length wire) emacs-agent-eval-output-limit))
          (should (string-match-p ":exit 23)\n\\[truncated" wire))
          (should (string-match "Full output: " wire))
          (setq file (car (read-from-string wire (match-end 0))))
          (should (file-in-directory-p file emacs-agent-data-directory))
          (should (= (logand (file-modes file) #o777) #o600))
          (should (= (logand (file-modes (file-name-directory file)) #o777) #o700))
          (with-temp-buffer (insert-file-contents file) (setq full (buffer-string)))
          (should (string-prefix-p (concat (make-string 2000 ?N) "\n=> (:output \"process-outputerr\"") full))
          (should (string-suffix-p ":exit 23)" full))
          (should (= calls 1))
          (should (file-exists-p file)))))))

(ert-deftest emacs-agent-process-texts-channel-integration ()
  (emacs-agent-process-test--directory
    (let* ((sh (emacs-agent-process-test--sh))
           (text "spaces 'quotes' \"double\" λ界\n$(touch INJECTED) \\n")
           (texts (vector text))
           (expression (format "(emacs-agent-run-process %S (list \"-c\" \"printf '%%s' \\\"$1\\\"\" \"argv0\" (car emacs-agent-texts)))" sh))
           (wire (emacs-agent-eval expression texts)))
      (should (string-prefix-p "\n=> " wire))
      (let ((result (read (substring wire 4))))
        (should (equal (plist-get result :output) text))
        (should (equal (last (plist-get result :command)) (list text)))
        (should (= (plist-get result :exit) 0)))
      (should (equal (aref texts 0) text))
      (should-not (file-exists-p "INJECTED")))))

(provide 'emacs-agent-process-test)

;;; emacs-agent-blocks-test.el --- Compact snapshots, unchanged live streams -*- lexical-binding: t; -*-
;; Loaded after store/history tests for their isolated fixtures.
(require 'ert)
(require 'emacs-agent)

(defun emacs-agent-blocks-test--read (file)
  "Read snapshot FILE as data."
  (with-temp-buffer (insert-file-contents file) (goto-char (point-min)) (read (current-buffer))))

(defun emacs-agent-blocks-test--render (events show-reasoning)
  "Render EVENTS through the real journal with SHOW-REASONING."
  (let ((session (make-emacs-agent-session :key 'global :events events))
        (emacs-agent-show-reasoning show-reasoning))
    (unwind-protect
        (progn
          (emacs-agent--render-log session)
          (with-current-buffer (emacs-agent-session-log-buffer session)
            (list (buffer-substring-no-properties (point-min) (point-max))
                  (mapcar (lambda (overlay)
                            (list (overlay-start overlay) (overlay-end overlay)
                                  (overlay-get overlay 'invisible)))
                          (car (overlay-lists))))))
      (when (buffer-live-p (emacs-agent-session-log-buffer session))
        (kill-buffer (emacs-agent-session-log-buffer session))))))

(defun emacs-agent-blocks-test--fixture (session)
  "Record synthetic interleaved streams and boundaries in SESSION."
  (let ((run (make-emacs-agent-run :id "run-10" :session session)))
    (dolist (spec '((reasoning "") (reasoning "think\n") (reasoning "λ")
                    (assistant "a") (assistant "") (assistant "\n")
                    (reasoning "more") (reasoning-end nil)
                    (assistant "b") (assistant-end nil)
                    (tool-call (:id "pair" :args (:expression "(+ 1 1)")))
                    (tool-result (:id "pair" :result "=> 2"))
                    (assistant "next") (assistant " response") (assistant-end nil)
                    (paused "Budget") (resumed "Continue")
                    (reasoning "final-answer reasoning") (reasoning-end nil)
                    (assistant "done") (assistant-end nil) (completed "Done")))
      (emacs-agent-session-record run (car spec) (cadr spec)))
    (setq run (make-emacs-agent-run :id "run-20" :session session))
    (emacs-agent-session-record run 'assistant "")
    (emacs-agent-session-record run 'assistant "")
    (emacs-agent-session-record run 'cancelled "Stop")))

(ert-deftest emacs-agent-blocks-roundtrip-rendering-boundaries-and-identity ()
  (emacs-agent-test-store
    (let ((session (emacs-agent-session-get nil)))
      (emacs-agent-blocks-test--fixture session)
      (let* ((live (emacs-agent-session-events session))
             (original (copy-tree live))
             (first (car live))
             (last-fragment (nth 2 live))
             (file (emacs-agent-store-save session))
             (data (emacs-agent-blocks-test--read file))
             (events (plist-get data :events))
             (block (car events)))
        (should (= (plist-get data :schema) 2))
        (should (eq first (car (emacs-agent-session-events session))))
        (should (equal live original))
        (should (< (length events) (length live)))
        (should (equal (plist-get block :payload) "think\nλ"))
        (should (equal (plist-get block :id) (plist-get first :id)))
        (should (equal (plist-get block :time) (plist-get first :time)))
        (should (equal (plist-get block :last-id) (plist-get last-fragment :id)))
        (should (equal (plist-get block :last-time) (plist-get last-fragment :time)))
        ;; Interleaving is not an invented end-of-accumulator marker.
        (should (eq (plist-get block :state) 'partial))
        (should (eq (plist-get (nth 2 events) :state) 'complete))
        (should (equal (plist-get (nth (- (length events) 2) events) :payload) ""))
        (dolist (show '(nil t))
          (should (equal (emacs-agent-blocks-test--render live show)
                         (emacs-agent-blocks-test--render events show))))
        (should (equal events (emacs-agent-store--compact-events events)))
        (should (> (cl-count ?\n (emacs-agent-test-store--text file)) 5))
        (setq emacs-agent-session--registry (make-hash-table :test #'equal))
        (let ((restored (emacs-agent-session-get nil)))
          (should (equal events (emacs-agent-session-events restored)))
          (should (equal data (emacs-agent-store--snapshot restored)))
          (emacs-agent-store-save restored)
          (should (equal data (emacs-agent-blocks-test--read file))))))))

(ert-deftest emacs-agent-blocks-live-cursor-and-accumulator-are-untouched ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((run (emacs-agent-test--submit "stream"))
             (session (emacs-agent-run-session run))
             (emacs-agent-session-event-functions (list #'emacs-agent--refresh-log)))
        (emacs-agent--render-log session)
        (emacs-agent-gptel--callback run "a" nil)
        (emacs-agent-gptel--callback run "b" nil)
        (let* ((events (emacs-agent-session-events session))
               (original (copy-tree events))
               (chunks (emacs-agent-run-assistant-chunks run))
               (messages (copy-tree (emacs-agent-session-messages session)))
               (buffer (emacs-agent-session-log-buffer session))
               (cursor (buffer-local-value 'emacs-agent-log--cursor buffer))
               (file (emacs-agent-store-save session))
               (first (emacs-agent-blocks-test--read file)))
          (should (eq events (emacs-agent-session-events session)))
          (should (equal events original))
          (should (eq chunks (emacs-agent-run-assistant-chunks run)))
          (should (equal chunks '("b" "a")))
          (should (equal messages (emacs-agent-session-messages session)))
          (should (eq cursor (buffer-local-value 'emacs-agent-log--cursor buffer)))
          (should (eq (plist-get (car (last (plist-get first :events))) :state) 'partial))
          (should (equal (plist-get (car (last (plist-get first :messages))) :text) "ab"))
          (emacs-agent-store-save session)
          (should (equal first (emacs-agent-blocks-test--read file)))
          (emacs-agent-gptel--callback run "c" nil)
          (emacs-agent-store-save session)
          (let ((second (emacs-agent-blocks-test--read file)))
            (should (equal (plist-get (car (last (plist-get second :events))) :payload) "abc"))
            (should (equal (plist-get (car (last (plist-get second :messages))) :text) "abc")))
          (emacs-agent-test--complete run "d")
          (emacs-agent-store-save session)
          (let* ((final (emacs-agent-blocks-test--read file))
                 (blocks (seq-filter #'emacs-agent-store--text-event-p (plist-get final :events))))
            (should (= (length blocks) 1))
            (should (equal (plist-get (car blocks) :payload) "abcd"))
            (should (eq (plist-get (car blocks) :state) 'complete))
            (should (= (length (plist-get final :messages)) 2))
            (should (equal (plist-get (cadr (plist-get final :messages)) :text) "abcd")))
          (should (equal (with-current-buffer buffer
                           (buffer-substring-no-properties (point-min) (point-max)))
                         (car (emacs-agent-blocks-test--render
                               (emacs-agent-session-events session) t)))))))))

(ert-deftest emacs-agent-blocks-autosave-cadence-and-immediate-boundary ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((run (emacs-agent-test--submit "checkpoint"))
             (session (emacs-agent-run-session run))
             (file (emacs-agent-store--file 'global))
             (clock 1000.0)
             (emacs-agent-store--last-save (make-hash-table :test #'eq))
             (emacs-agent-auto-save t)
             (emacs-agent-session-event-functions (list #'emacs-agent-store--auto-save)))
        (cl-letf (((symbol-function 'float-time) (lambda (&optional _) clock)))
          (emacs-agent-gptel--callback run "a" nil)
          (let ((initial (emacs-agent-test-store--text file)))
            (setq clock 1004.0)
            (emacs-agent-gptel--callback run "b" nil)
            (should (equal initial (emacs-agent-test-store--text file)))
            (setq clock 1005.0)
            (emacs-agent-gptel--callback run "c" nil)
            (let ((data (emacs-agent-blocks-test--read file)))
              (should (equal (plist-get (car (last (plist-get data :events))) :payload) "abc"))
              (should (eq (plist-get (car (last (plist-get data :events))) :state) 'partial)))
            ;; Terminal boundary forces a save without waiting another five seconds.
            (emacs-agent-test--complete run "d")
            (let* ((data (emacs-agent-blocks-test--read file))
                   (blocks (seq-filter #'emacs-agent-store--text-event-p (plist-get data :events))))
              (should (equal (plist-get (car blocks) :payload) "abcd"))
              (should (eq (plist-get (car blocks) :state) 'complete))
              (should (eq (plist-get (car (last (plist-get data :events))) :type) 'completed)))))))))

(ert-deftest emacs-agent-blocks-cancel-error-and-interruption-retain-partial ()
  (dolist (terminal '(checkpoint abort error))
    (emacs-agent-test-adapter
      (with-temp-buffer
        (let* ((run (emacs-agent-test--submit "partial"))
               (session (emacs-agent-run-session run)))
          (emacs-agent-gptel--callback run '(reasoning . "think") nil)
          (emacs-agent-gptel--callback run '(reasoning . " more") nil)
          (emacs-agent-gptel--callback run "answer" nil)
          (emacs-agent-gptel--callback run " tail" nil)
          (pcase terminal
            ('abort (emacs-agent-gptel--callback run 'abort nil))
            ('error (emacs-agent-gptel--callback run nil '(:status "failure"))))
          (let* ((file (emacs-agent-store-save session))
                 (data (emacs-agent-blocks-test--read file))
                 (blocks (seq-filter #'emacs-agent-store--text-event-p (plist-get data :events))))
            (should (equal (mapcar (lambda (b) (plist-get b :payload)) blocks)
                           '("think more" "answer tail")))
            (should (eq (plist-get (car blocks) :state) 'partial))
            ;; assistant-end is a flush marker even on abort/error, not success.
            (should (eq (plist-get (cadr blocks) :state)
                        (if (eq terminal 'checkpoint) 'partial 'complete)))
            (setq emacs-agent-session--registry (make-hash-table :test #'equal))
            (let ((restored (emacs-agent-session-get nil)))
              (should-not (emacs-agent-session-active-run restored))
              (should-not (emacs-agent-session-pending-runs restored))
              (should (equal (plist-get (cadr (emacs-agent-session-messages restored)) :text)
                             "answer tail"))
              (should (= (cl-count 'interrupted (emacs-agent-session-events restored)
                                   :key (lambda (e) (plist-get e :type)))
                         (if (eq terminal 'checkpoint) 1 0)))
              (let ((events (copy-tree (emacs-agent-session-events restored))))
                (emacs-agent-gptel--callback run "late text" nil)
                (should (equal events (emacs-agent-session-events restored)))))))))))

(ert-deftest emacs-agent-blocks-restored-tail-new-deltas-and-last-id ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session)))
      (dotimes (_ 150) (emacs-agent-session-record run 'assistant "x"))
      (let* ((last-id (plist-get (car (last (emacs-agent-session-events session))) :id))
             (file (emacs-agent-store-save session)))
        (setq emacs-agent-session--registry (make-hash-table :test #'equal)
              emacs-agent-session--counter 0)
        (let* ((restored (emacs-agent-session-get nil))
               (new (make-emacs-agent-run :id "run-10" :session restored)))
          (should (>= emacs-agent-session--counter
                      (string-to-number (substring last-id 6))))
          ;; Exercise mixture of a restored partial block and appended raw deltas.
          (emacs-agent-session-record new 'assistant "y")
          (emacs-agent-session-record new 'assistant-end nil)
          (emacs-agent-store-save restored)
          (let ((blocks (plist-get (emacs-agent-blocks-test--read file) :events)))
            (should (= (length blocks) 2))
            (should (equal (plist-get (car blocks) :payload) (concat (make-string 150 ?x) "y")))
            (should (equal (plist-get (car blocks) :last-id)
                           (plist-get (cadr (emacs-agent-session-events restored)) :id)))
            (should (eq (plist-get (car blocks) :state) 'complete))))))))

(ert-deftest emacs-agent-blocks-unknown-fields-and-all-boundaries ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session)))
      (emacs-agent-session-record run 'assistant "a")
      (plist-put (emacs-agent-session-record run 'assistant "b") :custom "retain")
      (emacs-agent-session-record run 'assistant "c")
      (emacs-agent-session-record run 'assistant-end nil)
      (emacs-agent-session-record run 'assistant "d")
      (setq run (make-emacs-agent-run :id "run-20" :session session))
      (emacs-agent-session-record run 'assistant "e")
      (let* ((events (emacs-agent-session-events session))
             (blocks (emacs-agent-store--compact-events events)))
        (should (= (length blocks) (length events)))
        (should (equal (plist-get (nth 1 blocks) :custom) "retain"))
        (should (equal blocks (emacs-agent-store--compact-events blocks)))
        (let ((other (copy-tree (car events))))
          (plist-put other :session-id "different-session")
          (should (= (length (emacs-agent-store--compact-events (list (car events) other))) 2)))))))

(ert-deftest emacs-agent-blocks-nonstring-boundary-and-wrong-end ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session)))
      (emacs-agent-session-record run 'assistant "a")
      (emacs-agent-session-record run 'assistant '(:unexpected "keep"))
      (emacs-agent-session-record run 'assistant "b")
      (emacs-agent-session-record
       (make-emacs-agent-run :id "run-20" :session session) 'assistant-end nil)
      (let ((events (plist-get (emacs-agent-store--snapshot session) :events)))
        (should (= (length events) 4))
        (should (equal (plist-get (nth 1 events) :payload) '(:unexpected "keep")))
        (should (eq (plist-get (car events) :state) 'partial))
        (should (eq (plist-get (nth 2 events) :state) 'partial))))))

(ert-deftest emacs-agent-blocks-validation-before-merge-and-old-schema-refusal ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session))
           (file (emacs-agent-store-save session))
           (original (emacs-agent-test-store--text file)))
      (emacs-agent-session-record run 'assistant "a")
      (let ((bad (emacs-agent-session-record run 'assistant "b")))
        (plist-put bad :id nil)
        (should-error (emacs-agent-store-save session))
        (should (equal original (emacs-agent-test-store--text file)))
        (plist-put bad :id "event-100"))
      (let ((data (emacs-agent-store--snapshot session)))
        (dolist (mutation '((:last-id nil) (:last-time nil) (:state nil) (:state complete)))
          (let ((copy (copy-tree data)))
            (plist-put (car (plist-get copy :events)) (car mutation) (cadr mutation))
            (should-error (emacs-agent-store--validate copy file))))
        (plist-put data :schema 1)
        (emacs-agent-test-store--write file (prin1-to-string data))
        (setq emacs-agent-session--registry (make-hash-table :test #'equal))
        (should-error (emacs-agent-session-get nil) :type 'user-error)
        (should (= (plist-get (emacs-agent-blocks-test--read file) :schema) 1))))))

(ert-deftest emacs-agent-blocks-write-failure-keeps-old-snapshot ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session))
           (file (emacs-agent-store-save session))
           (original (emacs-agent-test-store--text file)))
      (emacs-agent-session-record run 'assistant "new")
      (cl-letf (((symbol-function 'write-region)
                 (lambda (&rest _) (signal 'file-error '("injected write failure")))))
        (should-error (emacs-agent-store-save session) :type 'file-error))
      (should (equal original (emacs-agent-test-store--text file)))
      (should-not (directory-files emacs-agent-data-directory nil "\\`\\.snapshot-")))))

(ert-deftest emacs-agent-blocks-real-wire-unchanged-after-restore ()
  (emacs-agent-test-adapter
    (with-temp-buffer
      (let* ((run (emacs-agent-test--submit "replay"))
             (session (emacs-agent-run-session run)))
        (emacs-agent-gptel--callback run '(reasoning . "before tool") nil)
        (emacs-agent-gptel--callback run '(reasoning . " reasoning") nil)
        (emacs-agent-gptel--callback run '(reasoning . t) nil)
        (emacs-agent-test--real-tools run)
        (emacs-agent-gptel--callback run '(reasoning . "final reasoning only in journal") nil)
        (emacs-agent-gptel--callback run '(reasoning . t) nil)
        (emacs-agent-gptel--callback run "an" nil)
        (emacs-agent-test--complete run "swer")
        (let ((messages (copy-tree (emacs-agent-session-messages session)))
              ;; Compare wire JSON, not identity of schema hash-tables gptel rebuilds.
              (wire (mapcar (lambda (policy)
                              (gptel--json-encode (emacs-agent-test--wire run policy)))
                            '(nil current full))))
          (emacs-agent-store-save session)
          (setq emacs-agent-session--registry (make-hash-table :test #'equal))
          (let ((restored (emacs-agent-session-get nil)))
            (should (equal messages (emacs-agent-session-messages restored)))
            (should (seq-some (lambda (e) (equal (plist-get e :payload)
                                                "final reasoning only in journal"))
                              (emacs-agent-session-events restored)))
            (setf (emacs-agent-run-session run) restored)
            (should (equal wire (mapcar (lambda (policy)
                                         (gptel--json-encode (emacs-agent-test--wire run policy)))
                                       '(nil current full))))))))))

(ert-deftest emacs-agent-blocks-fresh-process-loads-without-runtime-or-gptel ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session))
           (library-directory (file-name-directory (locate-library "emacs-agent-store"))))
      (emacs-agent-session-record run 'reasoning "private reasoning fixture")
      (emacs-agent-session-record run 'reasoning " tail")
      (emacs-agent-store-save session)
      (with-temp-buffer
        (should
         (zerop
          (call-process
           (expand-file-name invocation-name invocation-directory) nil t nil
           "-Q" "--batch" "-L" library-directory "-l" "emacs-agent-store"
           "--eval"
           (prin1-to-string
            `(let* ((emacs-agent-data-directory ,emacs-agent-data-directory)
                    (emacs-agent-session--counter 0)
                    (session (emacs-agent-session-get nil)))
               (prin1 (list (length (emacs-agent-session-events session))
                            (plist-get (car (emacs-agent-session-events session)) :payload)
                            (emacs-agent-session-active-run session)
                            (emacs-agent-session-pending-runs session)
                            (featurep 'gptel))))))))
        (goto-char (point-min))
        (should (equal (read (current-buffer))
                       '(1 "private reasoning fixture tail" nil nil nil)))))))

(ert-deftest emacs-agent-blocks-synthetic-size-reduction ()
  (emacs-agent-test-store
    (let* ((session (emacs-agent-session-get nil))
           (run (make-emacs-agent-run :id "run-10" :session session)))
      (dotimes (_ 2000) (emacs-agent-session-record run 'reasoning "λ\n"))
      (emacs-agent-session-record run 'reasoning-end nil)
      (dotimes (_ 2000) (emacs-agent-session-record run 'assistant "x"))
      (emacs-agent-session-record run 'assistant-end nil)
      (let* ((events (emacs-agent-session-events session))
             (compact (emacs-agent-store--snapshot session))
             (old (copy-tree compact))
             (print-length nil) (print-level nil) (print-escape-newlines t)
             (file (emacs-agent-store-save session)))
        (plist-put old :schema 1)
        (plist-put old :events events)
        (let ((old-bytes (string-bytes (concat (prin1-to-string old) "\n")))
              (new-bytes (file-attribute-size (file-attributes file))))
          (should (= (length events) 4002))
          (should (= (length (plist-get compact :events)) 4))
          (should (< new-bytes (/ old-bytes 10)))
          (message "F0b synthetic: %d -> %d events; %d -> %d bytes"
                   (length events) (length (plist-get compact :events)) old-bytes new-bytes))))))


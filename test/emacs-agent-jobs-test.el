;;; emacs-agent-jobs-test.el --- Local asynchronous jobs -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'emacs-agent-jobs)

(defmacro emacs-agent-jobs-test--fixture (&rest body)
  "Run BODY with isolated jobs and clean up even failed launches."
  (declare (indent 0) (debug t))
  `(let* ((root (make-temp-file "agent-jobs-" t))
          (default-directory (file-name-as-directory root))
          (emacs-agent-job--registry (make-hash-table :test #'equal))
          (emacs-agent-job--counter 0)
          (emacs-agent-eval-output-limit 20000)
          (old-processes (process-list))
          (old-buffers (buffer-list)))
     (unwind-protect
         (progn ,@body)
       (dolist (process (process-list))
         (unless (memq process old-processes)
           (set-process-query-on-exit-flag process nil)
           (set-process-sentinel process #'ignore)
           (when (process-live-p process) (delete-process process))))
       (dolist (buffer (buffer-list))
         (unless (memq buffer old-buffers)
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory root t))))

(defun emacs-agent-jobs-test--sh ()
  "Find a POSIX shell without depending on the user's shell."
  (or (executable-find "sh")
      (and (file-executable-p "/bin/sh") "/bin/sh")
      (ert-skip "POSIX sh unavailable")))

(defun emacs-agent-jobs-test--await (predicate)
  "Dispatch process output until PREDICATE succeeds, with a deadline."
  (let ((deadline (+ (float-time) 10)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (funcall predicate))))

(defun emacs-agent-jobs-test--terminal (id)
  "Wait for ID to leave running and return its status."
  (emacs-agent-jobs-test--await
   (lambda () (not (eq (plist-get (emacs-agent-job-status id) :state) 'running))))
  (emacs-agent-job-status id))

(defun emacs-agent-jobs-test--process (id)
  "Return ID's actual process, not a PID or process name."
  (emacs-agent-job-process (gethash id emacs-agent-job--registry)))

(defun emacs-agent-jobs-test--start (script &rest arguments)
  "Launch real sh SCRIPT with literal ARGUMENTS."
  (emacs-agent-job-start (emacs-agent-jobs-test--sh)
                        (append (list "-c" script "argv0") arguments)))

(defun emacs-agent-jobs-test--ready (id text)
  "Wait until TEXT has arrived while ID is held at a shell read handshake."
  (emacs-agent-jobs-test--await
   (lambda () (equal (plist-get (emacs-agent-job-read id) :text) text)))
  (should (eq (plist-get (emacs-agent-job-status id) :state) 'running)))

(defun emacs-agent-jobs-test--source-state ()
  "Capture source contents, restriction, selection and modification state."
  (list (save-restriction (widen) (buffer-string))
        (point) (mark t) mark-active (point-min) (point-max)
        (buffer-modified-p) (buffer-chars-modified-tick) default-directory))

(ert-deftest emacs-agent-jobs-literal-argv-list-and-vector ()
  (emacs-agent-jobs-test--fixture
    (let* ((sh (emacs-agent-jobs-test--sh))
           (literal '("space here" "\"double\" 'single'" "λ界" "$(touch INJECTED)"
                      "; touch INJECTED" "*" "$HOME" "back\\slash" "" "line\nbreak"))
           (args (append '("-c" "printf '<%s>\\n' \"$@\"" "argv0") literal))
           (expected (mapconcat (lambda (s) (concat "<" s ">\n")) literal "")))
      (dolist (argv (list args (vconcat args)))
        (let ((id (emacs-agent-job-start sh argv)))
          (should (stringp id))
          (should (equal (plist-get (emacs-agent-jobs-test--terminal id) :command)
                         (cons sh args)))
          (should (equal (plist-get (emacs-agent-job-read id) :text) expected))))
      (should-not (file-exists-p "INJECTED")))))

(ert-deftest emacs-agent-jobs-cwd-relative-executable-and-path ()
  (emacs-agent-jobs-test--fixture
    (let ((sh (emacs-agent-jobs-test--sh)))
      (make-directory "work/subdir" t)
      (with-temp-file "work/child"
        (insert "#!" sh "\nprintf '%s\\n' \"$PWD\"; printf '%s' \"$1\"\n"))
      (set-file-modes "work/child" #o700)
      (dolist (program '("./child" "subdir/../child"))
        (let* ((id (emacs-agent-job-start program ["literal"]
                                         :directory "work/subdir/.."))
               (status (emacs-agent-jobs-test--terminal id)))
          (should (equal (plist-get status :directory) (expand-file-name "work/")))
          (should (equal (plist-get status :command)
                         (list (expand-file-name "work/child") "literal")))
          (should (equal (plist-get (emacs-agent-job-read id) :text)
                         (concat (directory-file-name (expand-file-name "work/"))
                                 "\nliteral")))))
      (let* ((exec-path (list (file-name-directory sh)))
             (shell-file-name "/not/a/shell")
             (id (emacs-agent-job-start "sh" '("-c" "printf native"))))
        (emacs-agent-jobs-test--terminal id)
        (should (equal (plist-get (emacs-agent-job-read id) :text) "native"))))))

(ert-deftest emacs-agent-jobs-output-unicode-stderr-final-chunk-and-exit ()
  (emacs-agent-jobs-test--fixture
    (let* ((id (emacs-agent-jobs-test--start
                "printf 'OUTλ'; printf 'ERR界' >&2; printf 'FINAL'; exit 17"))
           (status (emacs-agent-jobs-test--terminal id))
           (read (emacs-agent-job-read id))
           (text (plist-get read :text)))
      (should (eq (plist-get status :state) 'exited))
      (should (= (plist-get status :exit) 17))
      (should-not (plist-get status :signal))
      (should (plist-get status :created-at))
      (should (plist-get status :finished-at))
      (should-not (plist-get status :cancel-requested))
      ;; Different streams need not interleave in any particular order.
      (dolist (chunk '("OUTλ" "ERR界" "FINAL"))
        (should (string-match-p (regexp-quote chunk) text)))
      (should (= (length text) (length "OUTλERR界FINAL")))
      (should (= (plist-get status :output-size) (length text)))
      (should (plist-get status :output-available))
      (should (plist-get read :complete))
      (should-not (plist-get read :truncated))
      (should (= (plist-get read :next-offset) (length text)))
      (with-current-buffer (emacs-agent-job-buffer
                            (gethash id emacs-agent-job--registry))
        (should (eq buffer-undo-list t))))))

(ert-deftest emacs-agent-jobs-bounded-read-continuation-and-escaped-budget ()
  (emacs-agent-jobs-test--fixture
    (let* ((text (apply #'concat (make-list 100 "λ界\"\\\n\t")))
           (id (emacs-agent-jobs-test--start "printf '%s' \"$1\"" text)))
      (emacs-agent-jobs-test--terminal id)
      (dolist (budget (list 20000
                            (+ 120 (length (prin1-to-string
                                            (emacs-agent-job-read id :limit 1))))))
        (let ((emacs-agent-eval-output-limit budget)
              (offset 0) (pieces nil) (steps 0) result)
          (while (< offset (length text))
            (setq result (emacs-agent-job-read id :from offset :limit 1000))
            (should (emacs-agent-helpers--fit result))
            (should (equal result (emacs-agent-job-read id :from offset :limit 1000)))
            (should (= (plist-get result :from) offset))
            (push (plist-get result :text) pieces)
            (should (> (plist-get result :next-offset) offset))
            (should (= (plist-get result :next-offset)
                       (+ offset (length (plist-get result :text)))))
            (setq offset (plist-get result :next-offset))
            (should (eq (not (null (plist-get result :truncated)))
                        (< offset (length text))))
            (cl-incf steps)
            (should (<= steps (length text))))
          (should (plist-get result :complete))
          (should (equal (apply #'concat (nreverse pieces)) text))))
      (let ((page (emacs-agent-job-read id :from 1 :limit 3)))
        (should (equal (plist-get page :text) (substring text 1 4)))
        (should (= (plist-get page :next-offset) 4)))
      (let ((emacs-agent-eval-output-limit 1))
        (should-error (emacs-agent-job-read id))))))

(ert-deftest emacs-agent-jobs-read-running-current-eof-is-not-complete ()
  (emacs-agent-jobs-test--fixture
    (let ((id (emacs-agent-jobs-test--start
               "printf 'firstλ'; IFS= read -r answer; printf 'last界'")))
      (emacs-agent-jobs-test--ready id "firstλ")
      (let* ((first (emacs-agent-job-read id))
             (offset (plist-get first :next-offset))
             (eof (emacs-agent-job-read id :from offset)))
        (should-not (plist-get first :complete))
        (should-not (plist-get first :truncated))
        (should (equal (plist-get eof :text) ""))
        (should (= (plist-get eof :next-offset) offset))
        (should-not (plist-get eof :complete))
        (should-not (plist-get eof :truncated))
        ;; status/read must not dispatch events or wait for the shell.
        (cl-letf (((symbol-function 'accept-process-output)
                   (lambda (&rest _) (ert-fail "Unexpected process wait"))))
          (should (eq (plist-get (emacs-agent-job-status id) :state) 'running))
          (should (equal (emacs-agent-job-read id) first)))
        (process-send-string (emacs-agent-jobs-test--process id) "continue\n")
        (emacs-agent-jobs-test--terminal id)
        (let ((last (emacs-agent-job-read id :from offset)))
          (should (equal (plist-get last :text) "last界"))
          (should (plist-get last :complete))
          (should (equal (plist-get (emacs-agent-job-read id) :text) "firstλlast界")))))))

(ert-deftest emacs-agent-jobs-cancel-repeated-and-completed ()
  (emacs-agent-jobs-test--fixture
    (let ((id (emacs-agent-jobs-test--start "printf ready; IFS= read -r answer"))
          (other (emacs-agent-jobs-test--start "printf other; IFS= read -r answer")))
      (emacs-agent-jobs-test--ready id "ready")
      (emacs-agent-jobs-test--ready other "other")
      (should (plist-get (emacs-agent-job-cancel id) :cancel-requested))
      (emacs-agent-job-cancel id)
      (let ((status (emacs-agent-jobs-test--terminal id)))
        (should (eq (plist-get status :state) 'signaled))
        (should (integerp (plist-get status :signal)))
        (should-not (plist-get status :exit))
        (should (equal status (emacs-agent-job-cancel id))))
      (should (process-live-p (emacs-agent-jobs-test--process other)))
      (process-send-string (emacs-agent-jobs-test--process other) "done\n")
      (let ((status (emacs-agent-jobs-test--terminal other)))
        (emacs-agent-job-cancel other)
        (let ((after (emacs-agent-job-status other)))
          (dolist (key '(:state :exit :signal :finished-at :output-size))
            (should (equal (plist-get status key) (plist-get after key)))))))))

(ert-deftest emacs-agent-jobs-unknown-ids-invalid-arguments-and-active-forget ()
  (emacs-agent-jobs-test--fixture
    (dolist (id '("unknown" nil 42))
      (dolist (function '(emacs-agent-job-status emacs-agent-job-read
                         emacs-agent-job-cancel emacs-agent-job-forget))
        (should-error (funcall function id))))
    (let ((cycle (list "loop")) (calls 0))
      (setcdr cycle cycle)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest _) (cl-incf calls) (error "Must not launch"))))
        (dolist (program '(nil 7 ""))
          (should-error (emacs-agent-job-start program nil)))
        (dolist (args (list "string" 7 '("a" . "b") '("a" 3) ["a" nil] cycle))
          (should-error (emacs-agent-job-start "tool" args)))
        (dolist (directory '(nil 42))
          (should-error (emacs-agent-job-start "tool" nil :directory directory)))
        (should (zerop calls))))
    (let ((id (emacs-agent-jobs-test--start "printf ready; IFS= read -r answer")))
      (emacs-agent-jobs-test--ready id "ready")
      (should-error (emacs-agent-job-forget id))
      (should (process-live-p (emacs-agent-jobs-test--process id)))
      (dolist (from '(-1 1.5 "0" nil 100))
        (should-error (emacs-agent-job-read id :from from)))
      (dolist (limit '(0 -1 1.5 "1" nil))
        (should-error (emacs-agent-job-read id :limit limit))
        (should-error (emacs-agent-job-list :limit limit)))
      (dolist (from '(-1 1.5 "0" nil))
        (should-error (emacs-agent-job-list :from from))))))

(ert-deftest emacs-agent-jobs-independent-jobs-list-pagination-and-forget ()
  (emacs-agent-jobs-test--fixture
    (should (equal (plist-get (emacs-agent-job-list) :jobs) nil))
    (let (ids)
      (dotimes (number 4)
        (push (emacs-agent-jobs-test--start "printf '%s' \"$1\"" (number-to-string number)) ids))
      (dolist (id ids) (emacs-agent-jobs-test--terminal id))
      (let* ((first (emacs-agent-job-list :limit 2))
             (next (emacs-agent-job-list :from (plist-get first :next-offset) :limit 2)))
        (should (= (plist-get first :total) 4))
        (should (plist-get first :truncated))
        (should-not (plist-get next :truncated))
        (should (equal (mapcar (lambda (job) (plist-get job :id))
                              (append (plist-get first :jobs) (plist-get next :jobs))) ids)))
      (let ((emacs-agent-eval-output-limit 850) (offset 0) seen)
        (while (< offset 4)
          (let* ((page (emacs-agent-job-list :from offset :limit 20))
                 (jobs (plist-get page :jobs)))
            (should (emacs-agent-helpers--fit page))
            (should jobs)
            (setq seen (append seen (mapcar (lambda (job) (plist-get job :id)) jobs)))
            (if (plist-get page :truncated)
                (progn (should (> (plist-get page :next-offset) offset))
                       (setq offset (plist-get page :next-offset)))
              (setq offset 4))))
        (should (equal seen ids)))
      (let ((emacs-agent-eval-output-limit 1))
        (should-error (emacs-agent-job-list)))
      (cl-loop for id in ids for number downfrom 3 do
               (should (equal (plist-get (emacs-agent-job-read id) :text)
                              (number-to-string number))))
      (let* ((id (car ids))
             (buffer (emacs-agent-job-buffer (gethash id emacs-agent-job--registry))))
        (should (eq (emacs-agent-job-forget id) t))
        (should-not (buffer-live-p buffer))
        (should-not (gethash id emacs-agent-job--registry))
        (should-error (emacs-agent-job-status id))
        (should (= (plist-get (emacs-agent-job-list) :total) 3))))))

(ert-deftest emacs-agent-jobs-launch-errors-and-quits-clean-runtime-resources ()
  (emacs-agent-jobs-test--fixture
    (let ((sh (emacs-agent-jobs-test--sh))
          (make (symbol-function 'make-process)))
      (dolist (condition '((file-error "launch failed") (quit)))
        (let ((buffers (buffer-list)) (processes (process-list)) partial)
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest arguments)
                       (setq partial (apply make arguments))
                       (signal (car condition) (cdr condition)))))
            (should (equal (condition-case caught
                               (emacs-agent-job-start sh '("-c" "IFS= read -r answer"))
                             ((error quit) caught))
                           condition)))
          (should-not (process-live-p partial))
          (should (zerop (hash-table-count emacs-agent-job--registry)))
          (should-not (cl-set-difference (process-list) processes))
          (should-not (cl-set-difference (buffer-list) buffers))))
      (let ((buffers (buffer-list)))
        (should-error (emacs-agent-job-start "./nonexistent-program" nil))
        (should (zerop (hash-table-count emacs-agent-job--registry)))
        (should-not (cl-set-difference (buffer-list) buffers))))))

(ert-deftest emacs-agent-jobs-remote-rejection-before-launch-or-connections ()
  (emacs-agent-jobs-test--fixture
    (let ((calls 0) (io 0)
          (expand (symbol-function 'expand-file-name))
          (prefix "/ssh:tester@host:"))
      ;; Recognize syntax locally; any actual remote file operation is a failure.
      (cl-letf (((symbol-function 'expand-file-name)
                 (lambda (name &optional directory)
                   (cond ((string-prefix-p prefix name)
                          (concat prefix (funcall expand (substring name (length prefix)) "/")))
                         ((and directory (string-prefix-p prefix directory))
                          (concat prefix (funcall expand name (substring directory (length prefix)))))
                         (t (funcall expand name directory)))))
                ((symbol-function 'file-remote-p)
                 (lambda (name &rest _) (and (stringp name)
                                            (string-prefix-p prefix name) prefix)))
                ((symbol-function 'make-process)
                 (lambda (&rest _) (cl-incf calls) (error "Unexpected launch"))))
        (let ((file-name-handler-alist
               (list (cons "\\`/ssh:"
                           (lambda (operation &rest arguments)
                             (if (memq operation '(file-name-as-directory directory-file-name
                                                   file-name-directory file-name-nondirectory))
                                 (let ((file-name-handler-alist nil))
                                   (apply operation arguments))
                               (cl-incf io)
                               (error "Unexpected remote I/O: %S" operation)))))))
          (should-error (emacs-agent-job-start "tool" nil :directory (concat prefix "/work/")))
          (should-error (emacs-agent-job-start (concat prefix "/tool") nil))
          (let ((default-directory (concat prefix "/work/")))
            (should-error (emacs-agent-job-start "tool" nil))))
        (should (zerop calls))
        (should (zerop io))
        (should (zerop (hash-table-count emacs-agent-job--registry)))))))

(ert-deftest emacs-agent-jobs-source-state-no-saves-and-artifact-retained ()
  (emacs-agent-jobs-test--fixture
    (with-temp-buffer
      (buffer-enable-undo)
      (insert "before\nunsaved source\nafter\n")
      (setq buffer-file-name (expand-file-name "not-saved"))
      (narrow-to-region 8 22)
      (goto-char 10) (set-mark 16) (setq mark-active t)
      (let ((source (current-buffer))
            (state (emacs-agent-jobs-test--source-state))
            (undo buffer-undo-list))
        (cl-letf (((symbol-function 'save-buffer)
                   (lambda (&rest _) (ert-fail "Unexpected save")))
                  ((symbol-function 'do-auto-save)
                   (lambda (&rest _) (ert-fail "Unexpected autosave"))))
          (let ((id (emacs-agent-jobs-test--start
                     "printf artifact > generated; printf ready; IFS= read -r answer; exit 3")))
            (emacs-agent-jobs-test--ready id "ready")
            (emacs-agent-job-status id)
            (emacs-agent-job-read id)
            (emacs-agent-job-list)
            (process-send-string (emacs-agent-jobs-test--process id) "done\n")
            (should (= (plist-get (emacs-agent-jobs-test--terminal id) :exit) 3))
            (emacs-agent-job-cancel id)
            (emacs-agent-job-forget id)))
        (should (eq source (current-buffer)))
        (should (equal state (emacs-agent-jobs-test--source-state)))
        (should (eq undo buffer-undo-list))
        (should (file-exists-p "generated"))
        (should-not (file-exists-p "not-saved"))))))

(ert-deftest emacs-agent-jobs-killed-output-buffer-is-unavailable ()
  (emacs-agent-jobs-test--fixture
    (let ((id (emacs-agent-jobs-test--start "printf retained")))
      (emacs-agent-jobs-test--terminal id)
      (kill-buffer (emacs-agent-job-buffer (gethash id emacs-agent-job--registry)))
      (should-not (plist-get (emacs-agent-job-status id) :output-available))
      ;; The contract allows an explicit error or unavailable metadata, not an
      ;; apparently successful empty replacement for lost output.
      (let ((result (condition-case nil (emacs-agent-job-read id)
                      (error :unavailable))))
        (unless (eq result :unavailable)
          (should-not (plist-get result :output-available))
          (should-not (equal (plist-get result :text) ""))))
      (should (emacs-agent-job-forget id)))))

(ert-deftest emacs-agent-jobs-eval-texts-integration ()
  (require 'emacs-agent)
  (emacs-agent-jobs-test--fixture
    (with-temp-buffer
      (insert "unsaved source")
      (let* ((before (emacs-agent-jobs-test--source-state))
             (literal "quote\" newline\nλ; $(touch INJECTED)")
             (expression (format "(emacs-agent-job-start %S (list \"-c\" \"printf '%%s' \\\"$1\\\"\" \"argv0\" (car emacs-agent-texts)))"
                                 (emacs-agent-jobs-test--sh)))
             (id (read (substring (emacs-agent-eval expression (list literal)) 4))))
        (should (stringp id))
        (emacs-agent-jobs-test--terminal id)
        (let ((result (read (substring
                             (emacs-agent-eval (format "(emacs-agent-job-read %S)" id)) 4))))
          (should (eq (plist-get result :state) 'exited))
          (should (= (plist-get result :exit) 0))
          (should (plist-get result :complete))
          (should (equal (plist-get result :text) literal)))
        (should (equal before (emacs-agent-jobs-test--source-state)))
        (should-not (file-exists-p "INJECTED"))))))

(ert-deftest emacs-agent-jobs-metadata-is-independent ()
  (emacs-agent-jobs-test--fixture
    (let* ((argument (copy-sequence "original"))
           (id (emacs-agent-jobs-test--start "printf '%s' \"$1\"" argument))
           (key (copy-sequence id)))
      (aset argument 0 ?X)
      (aset id 0 ?X)
      (emacs-agent-jobs-test--terminal key)
      (let ((status (emacs-agent-job-status key)))
        (aset (plist-get status :id) 0 ?Y)
        (aset (car (plist-get status :command)) 0 ?Y)
        (aset (car (last (plist-get status :command))) 0 ?Y)
        (aset (plist-get status :directory) 0 ?Y))
      (let ((status (emacs-agent-job-status key)))
        (should (equal (plist-get status :id) key))
        (should (equal (car (plist-get status :command)) (emacs-agent-jobs-test--sh)))
        (should (equal (car (last (plist-get status :command))) "original"))
        (should (equal (plist-get status :directory) default-directory)))
      (should (equal (plist-get (emacs-agent-job-read key) :text) "original")))))

(ert-deftest emacs-agent-jobs-runtime-namespace-rejects-old-ids ()
  (emacs-agent-jobs-test--fixture
    (let* ((emacs-agent-job--instance "first-instance")
           (old (emacs-agent-jobs-test--start "printf old")))
      (emacs-agent-jobs-test--terminal old)
      ;; Simulate a fresh Emacs runtime with an empty registry/counter, not
      ;; persistence or replay.  Historical job IDs must not address new jobs.
      (let* ((emacs-agent-job--registry (make-hash-table :test #'equal))
             (emacs-agent-job--counter 0)
             (emacs-agent-job--instance "second-instance")
             (new (emacs-agent-jobs-test--start "printf new")))
        (emacs-agent-jobs-test--terminal new)
        (should-not (equal old new))
        (should-error (emacs-agent-job-status old))
        (should-error (emacs-agent-job-cancel old))
        (should (equal (plist-get (emacs-agent-job-read new) :text) "new"))))))


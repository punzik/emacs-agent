;;; emacs-agent-ui-test.el --- Conversation renderer tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-agent-log)
(require 'emacs-agent-store)

(defmacro emacs-agent-ui-test--journal (&rest body)
  "Run BODY with isolated SESSION and RUN in a disposable journal."
  (declare (indent 0) (debug t))
  `(let* ((emacs-agent-session--counter 0)
          (session (make-emacs-agent-session :id "ui-session" :key 'global))
          (run (make-emacs-agent-run :id "ui-run" :session session))
          (emacs-agent-session-event-functions (list #'emacs-agent--refresh-log))
          (emacs-agent-show-reasoning t)
          (emacs-agent-log-collapse-reasoning t)
          (emacs-agent-log-collapse-tools t))
     (unwind-protect
         (with-current-buffer (emacs-agent--log-buffer session) ,@body)
       (when (buffer-live-p (emacs-agent-session-log-buffer session))
         (kill-buffer (emacs-agent-session-log-buffer session))))))

(defun emacs-agent-ui-test--visible ()
  "Return visible text, excluding folded overlay bodies."
  (let ((text ""))
    (dotimes (i (- (point-max) (point-min)))
      (let ((position (+ (point-min) i)))
        (unless (invisible-p position)
          (setq text (concat text (buffer-substring-no-properties position (1+ position)))))))
    text))

(ert-deftest emacs-agent-ui-real-tab-bindings-ret-and-click ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'reasoning "Retained thinking")
    (goto-char (point-min))
    (let* ((button (button-at (point)))
           (overlay (button-get button 'emacs-agent-section)))
      (should (overlay-get overlay 'invisible))
      (dolist (key '("TAB" "<tab>" "TAB" "<tab>"))
        (forward-char 2)
        (backward-char 2)
        (should (eq (key-binding (kbd key)) #'emacs-agent-log-toggle-section))
        (let ((before (overlay-get overlay 'invisible)))
          (call-interactively (key-binding (kbd key)))
          (should-not (eq before (overlay-get overlay 'invisible)))))
      (should (eq (char-after (point-min)) ?▸))
      (should (eq (key-binding (kbd "RET")) #'push-button))
      (call-interactively (key-binding (kbd "RET")))
      (should-not (overlay-get overlay 'invisible))
      (should (eq (char-after (point-min)) ?▾))
      ;; Mouse activation uses this same text-button action.
      (should (eq (lookup-key emacs-agent-log-section-map [mouse-2]) #'push-button))
      (button-activate button)
      (should (overlay-get overlay 'invisible))
      (button-activate button)
      (goto-char (+ 2 (overlay-start overlay)))
      (call-interactively (key-binding (kbd "<tab>")))
      (should (= (point) (point-min)))
      (should (overlay-get overlay 'invisible)))))

(ert-deftest emacs-agent-ui-folded-stream-excludes-separator ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'reasoning "one")
    (let ((overlay (button-get (button-at (point-min)) 'emacs-agent-section)))
      (emacs-agent-session-record run 'usage '(:input-tokens 3))
      (emacs-agent-session-record run 'reasoning "two")
      (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                     "onetwo"))
      (should-not (invisible-p (overlay-end overlay)))
      (goto-char (point-min))
      (call-interactively (key-binding (kbd "TAB")))
      (should (string-match-p "onetwo" (emacs-agent-ui-test--visible)))
      (emacs-agent-session-record run 'reasoning-end nil)
      (emacs-agent-session-record run 'assistant "Answer")
      (should (string-match-p "Answer" (emacs-agent-ui-test--visible))))))

(ert-deftest emacs-agent-ui-normal-details-folds-and-canonical-history ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'user "Question")
    (emacs-agent-session-record run 'assistant "first")
    (emacs-agent-session-record run 'streaming "internal-state")
    (emacs-agent-session-record run 'assistant "second")
    (emacs-agent-session-record run 'reasoning "private reasoning")
    (emacs-agent-session-record run 'completed "Done")
    (emacs-agent-session-record run 'future-event '(:inspect "unknown payload"))
    (let ((events (copy-tree (emacs-agent-session-events session)))
          (messages (copy-tree (emacs-agent-session-messages session))))
      (should (string-match-p "You\nQuestion" (buffer-string)))
      (should (string-match-p "firstsecond" (buffer-string)))
      (should-not (string-match-p "ui-run\\|internal-state\\|completed" (buffer-string)))
      (goto-char (point-min))
      (search-forward "Reasoning")
      (emacs-agent-log-toggle-section)
      (goto-char (point-min))
      (search-forward "Question")
      (let ((position (point)))
        (should (eq (key-binding (kbd "D")) #'emacs-agent-log-toggle-details))
        (call-interactively (key-binding (kbd "D")))
        (should emacs-agent-log-details)
        (should (string-match-p "ui-run\\|internal-state" (buffer-string)))
        (should (string-match-p ":id" (buffer-string)))
        (should (string-match-p "unknown payload" (buffer-string)))
        (emacs-agent-log-toggle-details)
        (should (= (point) position)))
      (should (string-match-p "private reasoning" (emacs-agent-ui-test--visible)))
      (should (equal events (emacs-agent-session-events session)))
      (should (equal messages (emacs-agent-session-messages session)))
      (should-not (buffer-modified-p)))))

(ert-deftest emacs-agent-ui-tool-pairing-interleaved-runs-and-orphans ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'tool-call '(:id "same" :args (:expression "(first)")))
    (let ((other (make-emacs-agent-run :id "other-run" :session session)))
      (emacs-agent-session-record other 'tool-call '(:id "same" :args (:expression "(second)")))
      (emacs-agent-session-record run 'assistant "Between tools")
      (emacs-agent-session-record other 'tool-result '(:id "same" :result "second-result"))
      (emacs-agent-session-record run 'tool-result '(:id "same" :result "first-result"))
      (emacs-agent-session-record run 'tool-result '(:id "orphan" :result "unmatched-result"))
      (should (= (how-many "eval_elisp" (point-min) (point-max)) 2))
      (should (string-match-p "Tool result · unmatched" (buffer-string)))
      (should (string-match-p "Between tools" (emacs-agent-ui-test--visible)))
      (dolist (spec '(("ui-run" "(first)\n\nfirst-result")
                      ("other-run" "(second)\n\nsecond-result")))
        (let* ((block (gethash (list (car spec) "same") emacs-agent-log--tools))
               (overlay (plist-get block :overlay)))
          (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                         (cadr spec)))
          (should (overlay-get overlay 'invisible)))))))

(ert-deftest emacs-agent-ui-tool-preview-bounds-and-capture-notice ()
  (emacs-agent-ui-test--journal
    (let* ((expression (concat "(progn\n" (make-string 500 ?x) ")"))
           (body (concat "printed data\n[truncated; literal printed data]\n"
                         (mapconcat (lambda (_) (make-string 220 ?r)) '(1 2 3 4 5) "\n")))
           (notice "[truncated; showing tail. Full output: \"/not/read/output.txt\"]")
           (result (concat body "\n" notice)))
      (emacs-agent-session-record run 'tool-call (list :id "large" :args (list :expression expression)))
      (emacs-agent-session-record run 'tool-result (list :id "large" :result result))
      (let* ((block (gethash '("ui-run" "large") emacs-agent-log--tools))
             (overlay (plist-get block :overlay))
             (preview (overlay-get overlay 'preview))
             (text (buffer-substring-no-properties (overlay-start preview) (overlay-end preview))))
        (should (<= (length text) (+ 402 (length notice) 2)))
        (should (string-match-p (regexp-quote notice) (emacs-agent-ui-test--visible)))
        (goto-char (point-min))
        (call-interactively (key-binding (kbd "TAB")))
        (should (invisible-p (overlay-start preview)))
        (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                       (concat expression "\n\n" result)))
        (should (string-match-p (regexp-quote expression) (emacs-agent-ui-test--visible)))))
    (should (string-match-p "full output unavailable"
                            (emacs-agent-log--tool-preview
                             (concat (make-string 800 ?a)
                                     "\n[truncated; full output unavailable (evaluation already ran): failure]"))))))

(ert-deftest emacs-agent-ui-expanded-tool-updates-without-refolding ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'tool-call '(:id "open" :args (:expression "(message \"ERROR is data\")")))
    (goto-char (point-min))
    (call-interactively (key-binding (kbd "<tab>")))
    (emacs-agent-session-record run 'tool-result '(:id "open" :result "ERROR is data"))
    (let* ((block (gethash '("ui-run" "open") emacs-agent-log--tools))
           (overlay (plist-get block :overlay)))
      (should-not (overlay-get overlay 'invisible))
      (should (overlay-get (overlay-get overlay 'preview) 'invisible))
      (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                     "(message \"ERROR is data\")\n\nERROR is data"))
      (should-not (eq (get-text-property (point-min) 'face) 'error)))))

(ert-deftest emacs-agent-ui-details-preserves-reader-windows ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'user "Reader question")
    (emacs-agent-session-record run 'assistant (make-string 3000 ?a))
    (save-window-excursion
      (delete-other-windows)
      (set-window-buffer (selected-window) (current-buffer))
      (let* ((reader (selected-window))
             (follower (split-window-below))
             (position (+ (point-min) 6)))
        (set-window-buffer follower (current-buffer))
        (set-window-point reader position)
        (set-window-point follower (point-max))
        (emacs-agent-log-toggle-details)
        (should (eq (selected-window) reader))
        (should (= (window-point follower) (point-max)))
        (emacs-agent-log-toggle-details)
        (should (= (window-point reader) position))
        (should (= (window-point follower) (point-max)))
        (should (eq (selected-window) reader))))))

(ert-deftest emacs-agent-ui-important-events-and-summary-payload-only ()
  (emacs-agent-ui-test--journal
    (dolist (type '(paused interrupted error cancelled input-recovery))
      (emacs-agent-session-record run type (if (eq type 'input-recovery) nil "attention")))
    (emacs-agent-session-record run 'inherited-summary '(:summary "old inherited" :cut 2))
    (emacs-agent-session-record run 'compacted '(:summary "event summary" :cut 4))
    (dolist (label '("paused" "interrupted" "error" "cancelled" "Unsent input"))
      (should (string-match-p label (emacs-agent-ui-test--visible))))
    (should-not (string-match-p "event summary" (emacs-agent-ui-test--visible)))
    (should (string-match-p "event summary" (buffer-string)))
    (goto-char (point-min))
    (search-forward "Context compacted")
    (emacs-agent-log-toggle-section)
    (should (string-match-p "event summary" (emacs-agent-ui-test--visible)))))

(ert-deftest emacs-agent-ui-steering-displays-delivered-text ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'steering
                                '((:id "hidden-input-id" :state delivered :kind steering
                                   :run (:user-text "Please adjust this"))))
    (should (string-match-p "Please adjust this" (buffer-string)))
    (should-not (string-match-p "hidden-input-id" (buffer-string)))))

(defun emacs-agent-ui-test--render (events)
  "Return text and fold ranges for EVENTS using the real renderer."
  (let ((session (make-emacs-agent-session :id "ui-render" :key 'global :events events)))
    (unwind-protect
        (progn
          (emacs-agent--render-log session)
          (with-current-buffer (emacs-agent-session-log-buffer session)
            (list (buffer-substring-no-properties (point-min) (point-max))
                  (sort (mapcar (lambda (overlay)
                                  (list (overlay-start overlay) (overlay-end overlay)
                                        (overlay-get overlay 'invisible)))
                                (car (overlay-lists)))
                        (lambda (a b) (< (car a) (car b)))))))
      (when (buffer-live-p (emacs-agent-session-log-buffer session))
        (kill-buffer (emacs-agent-session-log-buffer session))))))

(ert-deftest emacs-agent-ui-live-and-snapshot-blocks-render-identically ()
  (emacs-agent-ui-test--journal
    (dolist (spec '((reasoning "") (reasoning "think") (reasoning " more")
                    (reasoning-end nil) (assistant "one") (assistant "two")
                    (assistant-end nil)
                    (tool-call (:id "pair" :args (:expression "(+ 1 1)")))
                    (tool-result (:id "pair" :result "=> 2"))
                    (assistant "next") (assistant " answer")
                    (assistant-end nil) (paused "Budget") (resumed "Continue")
                    (reasoning "last") (reasoning-end nil)
                    (assistant "done") (assistant-end nil) (completed "Done")))
      (emacs-agent-session-record run (car spec) (cadr spec)))
    (let* ((events (emacs-agent-session-events session))
           (original (copy-tree events))
           (saved (emacs-agent-store--compact-events events)))
      (should (equal (emacs-agent-ui-test--render events)
                     (emacs-agent-ui-test--render saved)))
      (should (equal events original)))))

(ert-deftest emacs-agent-ui-preview-tab-leaves-point-on-visible-header ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'tool-call '(:id "preview" :args (:expression "(+ 1 1)")))
    (emacs-agent-session-record run 'tool-result '(:id "preview" :result "=> 2"))
    (let* ((block (gethash '("ui-run" "preview") emacs-agent-log--tools))
           (body (plist-get block :overlay))
           (preview (overlay-get body 'preview)))
      (goto-char (overlay-start preview))
      (call-interactively (key-binding (kbd "TAB")))
      (should (= (point) (plist-get block :header)))
      (should-not (invisible-p (point)))
      (should-not (overlay-get body 'invisible)))))

(ert-deftest emacs-agent-ui-result-arrival-preserves-expanded-expression-reader ()
  (dolist (offset '(0 6))
    (emacs-agent-ui-test--journal
      (let ((expression "alpha\nreader-target\nomega"))
        (emacs-agent-session-record run 'tool-call
                                    (list :id "reader" :args (list :expression expression)))
        (goto-char (point-min))
        (emacs-agent-log-toggle-section)
        (let* ((block (gethash '("ui-run" "reader") emacs-agent-log--tools))
               (body (plist-get block :overlay))
               (suffix (substring expression offset)))
          (goto-char (+ (overlay-start body) offset))
          (let ((reader (copy-marker (point))))
            (unwind-protect
                (progn
                  (emacs-agent-session-record run 'tool-result '(:id "reader" :result "result text"))
                  (should (= (point) reader))
                  (should (looking-at-p (regexp-quote suffix)))
                  (should-not (invisible-p (point))))
              (set-marker reader nil))))))))

(ert-deftest emacs-agent-ui-reasoning-hide-policy-also-applies-to-details ()
  (emacs-agent-ui-test--journal
    (let ((emacs-agent-show-reasoning nil))
      (emacs-agent-session-record run 'reasoning "hidden-by-user")
      (emacs-agent-session-record run 'assistant "visible answer")
      (emacs-agent-log-toggle-details)
      (should-not (string-match-p "hidden-by-user" (buffer-string)))
      (should (string-match-p "visible answer" (buffer-string)))
      (should (equal (plist-get (car (emacs-agent-session-events session)) :payload)
                     "hidden-by-user")))))

(ert-deftest emacs-agent-ui-warning-recovery-and-unknown-metadata-policy ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'instructions '(:status none :warnings nil))
    (emacs-agent-session-record run 'assistant "one")
    (emacs-agent-session-record run 'future-metadata '(:internal "technical-secret"))
    (emacs-agent-session-record run 'assistant "two")
    (should (string-match-p "onetwo" (buffer-string)))
    (emacs-agent-session-record run 'instructions '(:status error :warnings ("broken instructions")))
    (emacs-agent-session-record run 'input-recovery
                                '((:id "recovery-hidden-id" :run (:user-text "unsent user text"))))
    (emacs-agent-session-record run 'compacted "Legacy summary notice")
    (should (string-match-p "broken instructions" (buffer-string)))
    (should (string-match-p "unsent user text" (buffer-string)))
    (should-not (string-match-p "recovery-hidden-id\\|technical-secret" (buffer-string)))
    (emacs-agent-log-toggle-details)
    (should (string-match-p "technical-secret" (buffer-string)))
    (should (string-match-p "recovery-hidden-id" (buffer-string)))))

(ert-deftest emacs-agent-ui-details-keeps-blank-separator-reader ()
  (emacs-agent-ui-test--journal
    (emacs-agent-session-record run 'user "First question")
    (emacs-agent-session-record run 'assistant "First answer")
    (emacs-agent-session-record run 'assistant-end nil)
    (emacs-agent-session-record run 'user "Second question")
    (goto-char (point-min))
    (search-forward "First question")
    (forward-char 1)
    (let ((position (point)))
      (should (eq (char-after) ?\n))
      (should (car (emacs-agent-log--anchor position)))
      (save-window-excursion
        (set-window-buffer (selected-window) (current-buffer))
        (set-window-point (selected-window) position)
        (set-window-start (selected-window) position t)
        (emacs-agent-log-toggle-details)
        (emacs-agent-log-toggle-details)
        (should (= (point) position))
        (should (= (window-point) position))
        (should (= (window-start) position))))))

(ert-deftest emacs-agent-ui-reasoning-face-covers-header-stream-and-details ()
  (emacs-agent-ui-test--journal
    (should (eq (face-attribute 'emacs-agent-log-reasoning-face :inherit)
                'shadow))
    (emacs-agent-session-record run 'reasoning "")
    (emacs-agent-session-record run 'reasoning "first")
    (goto-char (point-min))
    (should (eq (get-char-property (point) 'face) 'emacs-agent-log-reasoning-face))
    (emacs-agent-log-toggle-section)
    (let ((body (button-get (button-at (point-min)) 'emacs-agent-section)))
      (should (eq (get-char-property (overlay-start body) 'face)
                  'emacs-agent-log-reasoning-face))
      (emacs-agent-session-record run 'reasoning " second")
      (should (eq (get-char-property (1- (overlay-end body)) 'face)
                  'emacs-agent-log-reasoning-face)))
    (emacs-agent-session-record run 'reasoning-end nil)
    (emacs-agent-session-record run 'assistant "Answer")
    (goto-char (point-min))
    (search-forward "Answer")
    (should-not (eq (get-char-property (1- (point)) 'face)
                    'emacs-agent-log-reasoning-face))
    (emacs-agent-log-toggle-details)
    (goto-char (point-min))
    (search-forward "first")
    (should (eq (get-char-property (1- (point)) 'face)
                'emacs-agent-log-reasoning-face))))

(provide 'emacs-agent-ui-test)

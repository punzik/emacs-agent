;;; emacs-agent-session-test.el --- Session and UX tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-agent)

(defmacro emacs-agent-test-with-registry (&rest body)
  "Run BODY with an isolated registry; clean up created journal buffers."
  (declare (indent 0) (debug t))
  `(let ((emacs-agent-session--registry (make-hash-table :test #'equal))
         (emacs-agent-session--selected (make-hash-table :test #'equal))
         (emacs-agent-session--mutation nil)
         (emacs-agent-store--last-save (make-hash-table :test #'eq))
         (emacs-agent-session--counter 0)
         (emacs-agent-data-directory (make-temp-file "agent-session-test-" t))
         (emacs-agent-auto-save nil))
     (unwind-protect
         (cl-letf (((symbol-function 'emacs-agent-gptel-submit)
                    (lambda (run)
                      (emacs-agent-session-record run 'queued (emacs-agent-run-user-text run))
                      run)))
           ,@body)
       (maphash (lambda (_key session)
                  (when (buffer-live-p (emacs-agent-session-log-buffer session))
                    (kill-buffer (emacs-agent-session-log-buffer session))))
                emacs-agent-session--registry)
       (delete-directory emacs-agent-data-directory t))))

(ert-deftest emacs-agent-session-global-and-project-identities ()
  (emacs-agent-test-with-registry
    (let (first)
      (cl-letf (((symbol-function 'project-current) (lambda (&rest _) nil)))
        (with-temp-buffer
          (setq first (emacs-agent-session-get (emacs-agent-session-resolve-root))))
        (with-temp-buffer
          (should (eq first (emacs-agent-session-get (emacs-agent-session-resolve-root))))))
      (let* ((a (emacs-agent-session-get "/tmp/one/app/"))
             (b (emacs-agent-session-get "/tmp/two/app/")))
        (should-not (eq a b))
        (should (eq a (emacs-agent-session-get "/tmp/one/app/")))
        (should-not (equal (emacs-agent--session-name a) (emacs-agent--session-name b)))))))

(ert-deftest emacs-agent-session-canonical-and-remote-roots ()
  (cl-letf (((symbol-function 'project-current) (lambda (&rest _) 'test-project))
            ((symbol-function 'project-root) (lambda (_) "/tmp/alias/../alias"))
            ((symbol-function 'file-truename) (lambda (_) "/tmp/real/")))
    (should (equal (emacs-agent-session-resolve-root) "/tmp/real/")))
  (cl-letf (((symbol-function 'project-current) (lambda (&rest _) 'test-project))
            ((symbol-function 'project-root) (lambda (_) "/tmp/unavailable"))
            ((symbol-function 'file-truename) (lambda (_) (signal 'file-error '("unavailable")))))
    (should (equal (emacs-agent-session-resolve-root) "/tmp/unavailable/")))
  (cl-letf (((symbol-function 'project-current) (lambda (&rest _) 'test-project))
            ((symbol-function 'project-root) (lambda (_) "/ssh:host:/work/app/"))
            ((symbol-function 'file-truename) (lambda (_) (ert-fail "Remote truename called"))))
    (should (equal (emacs-agent-session-resolve-root) "/ssh:host:/work/app/"))))

(ert-deftest emacs-agent-session-files-in-one-project ()
  (emacs-agent-test-with-registry
    (let (first)
      (cl-letf (((symbol-function 'project-current) (lambda (&rest _) 'test-project))
                ((symbol-function 'project-root) (lambda (_) "/tmp/app/"))
                ((symbol-function 'file-truename) #'identity))
        (dolist (file '("/tmp/app/a.el" "/tmp/app/b.el"))
          (with-temp-buffer
            (setq buffer-file-name file)
            (let ((session (emacs-agent-session-get (emacs-agent-session-resolve-root))))
              (if first (should (eq first session)) (setq first session)))))))))

(ert-deftest emacs-agent-ask-captures-before-input-and-queues-fifo ()
  (emacs-agent-test-with-registry
    (let ((other (generate-new-buffer " *agent-other-project*"))
          (emacs-agent-prompt-history nil)
          first second session)
      (unwind-protect
          (with-temp-buffer
            (insert "first\nsecond\n")
            (goto-char 7)
            (setq-local default-directory "/tmp/original/")
            (cl-letf (((symbol-function 'emacs-agent-session-resolve-root)
                       (lambda () "/tmp/original/"))
                      ((symbol-function 'read-from-minibuffer)
                       (lambda (_prompt _initial map _read history)
                         (should (eq map emacs-agent-minibuffer-map))
                         (should (eq history 'emacs-agent-prompt-history))
                         (goto-char (point-max))
                         (set-buffer other)
                         "first user\nline")))
              (setq first (emacs-agent-ask)))
            (setq session (emacs-agent-run-session first))
            (should (equal (emacs-agent-session-project-root session) "/tmp/original/"))
            (should (= (plist-get (emacs-agent-run-editor-context first) :point) 7))
            (should (equal (emacs-agent-run-user-text first) "first user\nline"))
            (goto-char 3)
            (cl-letf (((symbol-function 'emacs-agent-session-resolve-root)
                       (lambda () "/tmp/original/"))
                      ((symbol-function 'read-from-minibuffer) (lambda (&rest _) "second")))
              (setq second (emacs-agent-ask)))
            (should (eq session (emacs-agent-run-session second)))
            (should (equal (emacs-agent-session-pending-runs session) (list first second)))
            (should (= (plist-get (emacs-agent-run-editor-context second) :point) 3))
            (should (= (plist-get (emacs-agent-run-editor-context first) :point) 7)))
        (kill-buffer other)))))

(ert-deftest emacs-agent-ask-empty-and-aborted-input ()
  (emacs-agent-test-with-registry
    (with-temp-buffer
      (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                ((symbol-function 'emacs-agent-resources-capture)
                 (lambda (&rest _) (ert-fail "Blank input read instructions")))
                ((symbol-function 'read-from-minibuffer) (lambda (&rest _) " \n\t ")))
        (should-not (emacs-agent-ask))
        (should (= (hash-table-count emacs-agent-session--registry) 0)))
      (cl-letf (((symbol-function 'emacs-agent-session-resolve-root) (lambda () nil))
                ((symbol-function 'emacs-agent-resources-capture)
                 (lambda (&rest _) (ert-fail "Aborted input read instructions")))
                ((symbol-function 'read-from-minibuffer) (lambda (&rest _) (signal 'quit nil))))
        (should (eq (condition-case nil (emacs-agent-ask) (quit 'quit)) 'quit))
        (should (= (hash-table-count emacs-agent-session--registry) 0))))))

(ert-deftest emacs-agent-journal-uses-owner-and-source ()
  (emacs-agent-test-with-registry
    (let ((source (generate-new-buffer " *agent-source*")))
      (unwind-protect
          (let* ((session (emacs-agent-session-get "/tmp/app/"))
                 (journal (emacs-agent--log-buffer session)))
            (setf (emacs-agent-session-last-source-buffer session) source)
            (with-current-buffer journal
              (cl-letf (((symbol-function 'emacs-agent-session-resolve-root)
                         (lambda () (ert-fail "Resolved project from journal")))
                        ((symbol-function 'read-from-minibuffer) (lambda (&rest _) "journal prompt")))
                (let ((run (emacs-agent-ask)))
                  (should (eq (emacs-agent-run-session run) session))
                  (should (eq (emacs-agent-run-source-buffer run) source))))
              (should buffer-read-only)
              (should-error (insert "manual") :type 'buffer-read-only)
              (should-not (string-match-p "emacs-context" (buffer-string))))
            (kill-buffer source)
            (with-current-buffer journal
              (should-error (emacs-agent-ask) :type 'user-error)
              (cl-letf (((symbol-function 'display-buffer) #'ignore))
                (emacs-agent-show))))
        (when (buffer-live-p source) (kill-buffer source))))))

(ert-deftest emacs-agent-minibuffer-map-contract ()
  (should (eq (lookup-key emacs-agent-minibuffer-map (kbd "RET")) 'exit-minibuffer))
  (should (eq (lookup-key emacs-agent-minibuffer-map (kbd "C-j")) 'newline))
  (should (eq (lookup-key emacs-agent-minibuffer-map (kbd "M-p")) 'previous-history-element))
  (should (eq (lookup-key emacs-agent-minibuffer-map (kbd "M-n")) 'next-history-element))
  (should (eq (lookup-key emacs-agent-minibuffer-map (kbd "C-g"))
              (lookup-key minibuffer-local-map (kbd "C-g")))))

(ert-deftest emacs-agent-session-multiple-conversations-and-pure-selection ()
  (emacs-agent-test-with-registry
    (should-not (emacs-agent-session-selected "/tmp/multi/"))
    (should-not (file-exists-p (expand-file-name "conversations" emacs-agent-data-directory)))
    (let* ((first (emacs-agent-session-get "/tmp/multi/"))
           (second (emacs-agent-session--new "/tmp/multi/" "same" first)))
      (should (emacs-agent-session-registered-p first))
      (should (emacs-agent-session-registered-p second))
      (should-not (emacs-agent-session-registered-p (copy-emacs-agent-session first)))
      (should-not (equal (emacs-agent-session-id first) (emacs-agent-session-id second)))
      (should (equal (emacs-agent-session-key first) (emacs-agent-session-key second)))
      (should (eq second (emacs-agent-session-get "/tmp/multi/")))
      (should (eq first (emacs-agent-session--select first second)))
      (should (eq first (emacs-agent-session-selected "/tmp/multi/")))
      (should (= (hash-table-count emacs-agent-session--registry) 2)))))

(ert-deftest emacs-agent-session-id-has-entropy-and-checks-durable-collisions ()
  (emacs-agent-test-with-registry
    (let* ((a (emacs-agent-session--new nil))
           (emacs-agent-session--counter 0)
           (b (emacs-agent-session--new nil)))
      (should-not (equal (emacs-agent-session-id a) (emacs-agent-session-id b))))
    (let ((calls 0) (original (symbol-function 'file-exists-p)))
      (cl-letf (((symbol-function 'file-exists-p)
                 (lambda (file)
                   (if (string-match-p "/conversations/" file)
                       (= (cl-incf calls) 1)
                     (funcall original file)))))
        (emacs-agent-session--fresh nil))
      (should (= calls 2)))))

(ert-deftest emacs-agent-session-idle-and-involved-source-guards ()
  (emacs-agent-test-with-registry
    (let* ((a (emacs-agent-session-get nil))
           (b (emacs-agent-session--new nil))
           (other (emacs-agent-session-get "/tmp/other/")))
      (dolist (state '(prepared queued withdrawn))
        (setf (emacs-agent-session-inputs a)
              (list (make-emacs-agent-input :state state)))
        (should (eq (not (null (emacs-agent-session-idle-p a))) (eq state 'withdrawn))))
      (setf (emacs-agent-session-inputs a) nil)
      (dolist (field '(active-run pending-runs compaction-job))
        (pcase field
          ('active-run (setf (emacs-agent-session-active-run a) t))
          ('pending-runs (setf (emacs-agent-session-pending-runs a) '(busy)))
          ('compaction-job (setf (emacs-agent-session-compaction-job a) t)))
        (should-not (emacs-agent-session-idle-p a))
        (should-error (emacs-agent-session--new nil nil a) :type 'user-error)
        (should-error (emacs-agent-session--select a) :type 'user-error)
        (should-error (emacs-agent-session--clone a) :type 'user-error)
        (should-error (emacs-agent-session--rename a "busy") :type 'user-error)
        (setf (emacs-agent-session-active-run a) nil
              (emacs-agent-session-pending-runs a) nil
              (emacs-agent-session-compaction-job a) nil))
      (should-error (emacs-agent-session--select a other) :type 'user-error)
      (should-error (emacs-agent-session--new nil nil other) :type 'user-error)
      (should (eq b (emacs-agent-session-selected nil)))
      (setf (emacs-agent-session-active-run b) t)
      (should-error (emacs-agent-session--select a) :type 'user-error)
      (should-error (emacs-agent-session--clone a) :type 'user-error))))

(ert-deftest emacs-agent-session-transaction-failures-and-reentrant-admission ()
  (emacs-agent-test-with-registry
    (let* ((root "/tmp/transaction/")
           (old (emacs-agent-session-get root))
           (history '((:role user :run-id "run-old" :text "keep"))))
      (setf (emacs-agent-session-messages old) history)
      (dolist (operation '(new select clone))
        (let ((target (emacs-agent-session--new root)))
          (emacs-agent-session--select old)
          (cl-letf (((symbol-function 'emacs-agent-store-select)
                     (lambda (_)
                       (should emacs-agent-session--mutation)
                       (should (eq old (emacs-agent-session-get root)))
                       (should-error (emacs-agent-session--new root) :type 'user-error)
                       (should-error (emacs-agent-session--select target) :type 'user-error)
                       (should-error (emacs-agent-session-get "/tmp/uncreated/") :type 'user-error)
                       (should-error (emacs-agent-session-enqueue old "no" nil (current-buffer) nil)
                                     :type 'user-error)
                       (signal 'file-error '("pointer failure")))))
            (should-error
             (pcase operation
               ('new (emacs-agent-session--new root))
               ('select (emacs-agent-session--select target))
               ('clone (emacs-agent-session--clone old)))
             :type 'file-error))
          (should (eq old (emacs-agent-session-selected root)))
          (should (eq history (emacs-agent-session-messages old)))
          (should-not (emacs-agent-session-pending-runs old))
          (should-not (emacs-agent-session-last-source-buffer old))
          (should-not emacs-agent-session--mutation)))
      (let ((emacs-agent-session--mutation t))
        (cl-letf (((symbol-function 'emacs-agent-resources-capture)
                   (lambda (&rest _) (ert-fail "Instructions captured while locked"))))
          (should-error (emacs-agent-session-prepare old "no" nil nil nil) :type 'user-error))))))

(ert-deftest emacs-agent-session-switch-saves-selected-journal-owner-and-candidate ()
  (emacs-agent-test-with-registry
    (let* ((root "/tmp/source-guard/")
           (source (emacs-agent-session-get root))
           (old (emacs-agent-session--new root))
           (save (symbol-function 'emacs-agent-store-save))
           (pointer (symbol-function 'emacs-agent-store-select))
           saved)
      (cl-letf (((symbol-function 'emacs-agent-store-save)
                 (lambda (session)
                   (should (eq old (emacs-agent-session-selected root)))
                   (push session saved)
                   (funcall save session)))
                ((symbol-function 'emacs-agent-store-select)
                 (lambda (session)
                   (should (eq old (emacs-agent-session-selected root)))
                   (should (= (length saved) 3))
                   (funcall pointer session))))
        (let ((new (emacs-agent-session--new root nil source)))
          (should (equal (nreverse saved) (list old source new)))
          (should (eq new (emacs-agent-session-selected root))))))))

(ert-deftest emacs-agent-session-snapshot-failure-keeps-old-selection-and-history ()
  (emacs-agent-test-with-registry
    (let* ((root "/tmp/snapshot-failure/")
           (old (emacs-agent-session-get root))
           (save (symbol-function 'emacs-agent-store-save))
           (history '((:role user :run-id "run-keep" :text "keep"))))
      (setf (emacs-agent-session-messages old) history)
      (dolist (failure '(1 2))
        (let ((calls 0))
          (cl-letf (((symbol-function 'emacs-agent-store-save)
                     (lambda (session)
                       (if (= (cl-incf calls) failure)
                           (signal 'file-error '("snapshot failure"))
                         (funcall save session)))))
            (should-error (emacs-agent-session--new root) :type 'file-error)))
        (should (eq old (emacs-agent-session-selected root)))
        (should (eq history (emacs-agent-session-messages old)))
        (should (= (hash-table-count emacs-agent-session--registry) 1))
        (should-not emacs-agent-session--mutation)))))

(ert-deftest emacs-agent-session-rename-preview-cleanup-and-validation ()
  (emacs-agent-test-with-registry
    (let* ((session (emacs-agent-session-get nil))
           (id (emacs-agent-session-id session)))
      (emacs-agent-session--rename session "duplicate allowed")
      (should (equal id (emacs-agent-session-id session)))
      (let ((count (hash-table-count emacs-agent-store--last-save)))
        (should-error (emacs-agent-session--rename session "bad\nname"))
        (cl-letf (((symbol-function 'rename-file)
                   (lambda (&rest _) (signal 'file-error '("rename failed")))))
          (should-error (emacs-agent-session--rename session "not published")))
        (should (equal (emacs-agent-session-name session) "duplicate allowed"))
        (should (= count (hash-table-count emacs-agent-store--last-save))))
      (emacs-agent-session--rename session "")
      (emacs-agent-session--rename session nil)
      (should-not (emacs-agent-session-name session)))))

(ert-deftest emacs-agent-session-clone-is-deep-historical-and-inert ()
  (emacs-agent-test-with-registry
    (let* ((source (emacs-agent-session-get "/tmp/clone/"))
           (messages '((:role user :run-id "run-history" :input-id "input-history" :text "old")))
           (compaction '(:cut 1 :summary "summary" :tokens-before 20 :model "m" :backend "b" :time 1)))
      (setf (emacs-agent-session-messages source) messages
            (emacs-agent-session-compaction source) compaction
            (emacs-agent-session-usage-anchor source)
            '(:tokens 10 :estimate 20 :model "m" :backend "b" :cut 1 :source gptel-normalized)
            (emacs-agent-session-inputs source)
            (list (make-emacs-agent-input
                   :id "input-withdrawn" :kind 'ask :state 'withdrawn :backend-name "backend"
                   :run (make-emacs-agent-run :id "run-withdrawn" :session source
                                              :user-text "not delivered" :tool-budget 0)))
            (emacs-agent-session-last-source-buffer source) (current-buffer))
      (emacs-agent-session-record (make-emacs-agent-run :id "run-history" :session source)
                                  'tool-result '(:id "tool-history" :path "/old/artifact"))
      (let* ((clone (emacs-agent-session--clone source "copy"))
             (event (car (emacs-agent-session-events clone))))
        (should (eq clone (emacs-agent-session-selected "/tmp/clone/")))
        (should (equal (plist-get (emacs-agent-session-provenance clone) :source-id)
                       (emacs-agent-session-id source)))
        (should (equal (plist-get event :session-id) (emacs-agent-session-id clone)))
        (should (equal (plist-get event :run-id) "run-history"))
        (should (equal (emacs-agent-session-messages clone) messages))
        (should (equal (emacs-agent-session-compaction clone) compaction))
        (should-not (eq (emacs-agent-session-compaction clone) compaction))
        (should-not (emacs-agent-session-inputs clone))
        (should-not (emacs-agent-session-usage-anchor clone))
        (should-not (emacs-agent-session-last-source-buffer clone))
        (setf (plist-get (car (emacs-agent-session-messages clone)) :text) "changed"
              (plist-get (plist-get event :payload) :path) "changed")
        (should (equal (plist-get (car messages) :text) "old"))
        (should (equal (plist-get (plist-get (car (emacs-agent-session-events source)) :payload) :path)
                       "/old/artifact"))))))


;;; emacs-agent-log-test.el --- Disposable incremental journal tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-agent)

(defmacro emacs-agent-test-log (&rest body)
  "Run BODY with lexical SESSION/RUN and an isolated journal."
  (declare (indent 0) (debug t))
  `(let* ((emacs-agent-session--counter 0)
          (session (make-emacs-agent-session :id "log-session" :key 'global))
          (run (make-emacs-agent-run :id "log-run" :session session))
          (emacs-agent-session-event-functions (list #'emacs-agent--refresh-log)))
     (unwind-protect
         (with-current-buffer (emacs-agent--log-buffer session) ,@body)
       (when (buffer-live-p (emacs-agent-session-log-buffer session))
         (kill-buffer (emacs-agent-session-log-buffer session))))))

(ert-deftest emacs-agent-log-append-stream-without-redraw-or-point-jump ()
  (emacs-agent-test-log
    (emacs-agent-session-record run 'user "Original user text")
    (goto-char (point-min))
    (search-forward "Original")
    (let ((position (point))
          (prefix (buffer-string)))
      (emacs-agent-session-record run 'assistant "hel")
      (emacs-agent-session-record run 'assistant "lo")
      (should (= (point) position))
      (should (string-prefix-p prefix (buffer-string)))
      (should-not (string-match-p "log-run" (buffer-string)))
      (should (string-match-p "hello" (buffer-string)))
      (should-not (buffer-modified-p))
      (should-error (insert "manual edit") :type 'buffer-read-only)
      (should-not (emacs-agent-session-messages session)))
    (goto-char (point-max))
    (emacs-agent-session-record run 'assistant "!")
    (should (= (point) (point-max)))
    (emacs-agent-session-record run 'assistant-end nil)
    (emacs-agent-session-record run 'assistant "New response")
    (should (string-match-p "hello!\n\nNew response" (buffer-string)))))

(ert-deftest emacs-agent-log-tools-fold-and-history-is-unchanged ()
  (emacs-agent-test-log
    (let ((emacs-agent-log-collapse-tools t))
      (emacs-agent-session-record run 'tool-call
                                  '(:id "call" :args (:expression "(+ 1 1)")))
      (goto-char (point-min))
      (let* ((button (button-at (point)))
             (overlay (button-get button 'emacs-agent-section))
             (events (copy-tree (emacs-agent-session-events session))))
        (should (overlay-get overlay 'invisible))
        (should (string-match-p "eval_elisp" (buffer-string)))
        (emacs-agent-log-toggle-section)
        (should-not (overlay-get overlay 'invisible))
        (button-activate button)
        (should (overlay-get overlay 'invisible))
        (should (equal events (emacs-agent-session-events session)))))))

(ert-deftest emacs-agent-log-folded-reasoning-extends-body-only ()
  (emacs-agent-test-log
    (let ((emacs-agent-log-collapse-reasoning t))
      (emacs-agent-session-record run 'reasoning "part1")
      (let* ((button (button-at (point-min)))
             (overlay (button-get button 'emacs-agent-section)))
        (emacs-agent-session-record run 'reasoning "part2")
        (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                       "part1part2"))
        (should (overlay-get overlay 'invisible))
        (emacs-agent-session-record run 'reasoning-end nil)
        (emacs-agent-session-record run 'assistant "Answer")
        (should-not (invisible-p (- (point-max) 3)))
        (should (= (how-many "Reasoning" (point-min) (point-max)) 1))))))

(ert-deftest emacs-agent-log-closed-view-does-not-resurrect-and-replays ()
  (emacs-agent-test-log
    (emacs-agent-session-record run 'user "Question")
    (emacs-agent-session-record run 'assistant "first")
    (let ((old (current-buffer)))
      (kill-buffer old)
      (emacs-agent-session-record run 'assistant "second")
      (emacs-agent-session-record run 'completed "Done")
      (should-not (buffer-live-p (emacs-agent-session-log-buffer session)))
      (emacs-agent--render-log session)
      (with-current-buffer (emacs-agent-session-log-buffer session)
        (should (string-match-p "firstsecond" (buffer-string)))
        (should-not (string-match-p "completed" (buffer-string)))
        (let ((text (buffer-string)))
          (emacs-agent-log-refresh)
          (should (equal text (buffer-string))))))))

(ert-deftest emacs-agent-log-preserves-reader-and-follows-only-tail-window ()
  (emacs-agent-test-log
    (emacs-agent-session-record run 'user (mapconcat #'number-to-string (number-sequence 1 60) "\n"))
    (save-window-excursion
      (delete-other-windows)
      (set-window-buffer (selected-window) (current-buffer))
      (let* ((reader (selected-window))
             (follower (split-window-below))
             (position (+ (point-min) 3)))
        (set-window-buffer follower (current-buffer))
        (set-window-point reader position)
        (set-window-start reader (point-min) t)
        (set-window-point follower (point-max))
        (let ((start (window-start reader)))
          (emacs-agent-session-record run 'assistant "streamed text")
          (should (= (window-point reader) position))
          (should (= (window-start reader) start))
          (should (= (window-point follower) (point-max)))
          (should (eq (selected-window) reader)))))))

(ert-deftest emacs-agent-log-reasoning-display-policy-keeps-data ()
  (emacs-agent-test-log
    (let ((emacs-agent-show-reasoning nil))
      (emacs-agent-session-record run 'reasoning "actual hidden thinking")
      (emacs-agent-session-record run 'assistant "Visible answer")
      (should-not (string-match-p "actual hidden thinking" (buffer-string)))
      (should (string-match-p "Visible answer" (buffer-string)))
      (should (equal (plist-get (car (emacs-agent-session-events session)) :payload)
                     "actual hidden thinking")))))

;;; emacs-agent-log-test.el ends here

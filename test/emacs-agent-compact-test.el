(ert-deftest emacs-agent-compact-auto-after-batch-preserves-steering-and-never-reexecutes ()
  (dolist (cancel '(nil t source))
    (emacs-agent-compact-test--fixture
      (with-temp-buffer
        (insert "a\nb\nc\n") (goto-char 1)
        (let* ((emacs-agent-context-history 'current)
               (emacs-agent-f2-spike-effects nil)
               (source (current-buffer))
               (run (emacs-agent-test--submit "initial goal"))
               (session (emacs-agent-run-session run))
               (fsm (emacs-agent-f2-spike--dry-fsm run))
               (gptel-use-curl t) first second wire)
          (goto-char 3)
          (setq first (emacs-agent-input-queue-steer run "STEER-FIRST" (emacs-agent-context-capture nil) source nil))
          (gptel--parse-response
           (emacs-agent-run-backend run)
           '(:choices [(:message (:role "assistant" :content :null
                                  :tool_calls [(:id "large-one" :type "function"
                                               :function (:name "eval_elisp" :arguments "{\"expression\":\"(push 'one emacs-agent-f2-spike-effects) (make-string 30000 ?a)\"}"))
                                              (:id "large-two" :type "function"
                                               :function (:name "eval_elisp" :arguments "{\"expression\":\"(push 'two emacs-agent-f2-spike-effects) (make-string 30000 ?b)\"}"))])
                         :finish_reason "tool_calls")])
           (gptel-fsm-info fsm))
          (cl-letf (((symbol-function 'gptel-curl-get-response)
                     (lambda (state) (setq wire (copy-tree (plist-get (gptel-fsm-info state) :data))))))
            (gptel--fsm-transition fsm 'TOOL)
            (should-not wire)
            (should (= (emacs-agent-run-tool-count run) 2))
            (should (equal (reverse emacs-agent-f2-spike-effects) '(one two)))
            (should (eq (emacs-agent-input-state first) 'queued))
            (let ((job (emacs-agent-session-compaction-job session)))
              (should job)
              (goto-char 5)
              (setq second (emacs-agent-input-queue-steer run "STEER-SECOND" (emacs-agent-context-capture nil) source nil))
              (if cancel
                  (progn
                    (if (eq cancel 'source)
                        (emacs-agent-gptel--finish run 'failed "Source run stopped")
                      (emacs-agent-gptel-cancel session))
                    (should (eq (emacs-agent-run-status run) (if (eq cancel 'source) 'failed 'cancelled)))
                    (should (eq (emacs-agent-input-state first) 'withdrawn))
                    (should (eq (emacs-agent-input-state second) 'withdrawn))
                    (emacs-agent-compact-test--complete job "late summary")
                    (should-not wire)
                    (should-not (emacs-agent-session-compaction session)))
                (emacs-agent-compact-test--complete job "Both tool effects completed once; initial goal remains.")
                (should wire)
                (should (eq (emacs-agent-input-state first) 'delivered))
                (should (eq (emacs-agent-input-state second) 'delivered))
                (should (= (emacs-agent-f2-spike--contexts (append (plist-get wire :messages) nil)) 3))
                (should (string-match-p "STEER-FIRST" (prin1-to-string wire)))
                (should (string-match-p "STEER-SECOND" (prin1-to-string wire))))))
          (should (= (emacs-agent-run-tool-count run) 2))
          (should (equal (reverse emacs-agent-f2-spike-effects) '(one two))))))))

(ert-deftest emacs-agent-compact-public-command-and-previous-summary-failure ()
  (emacs-agent-compact-test--fixture
    (with-temp-buffer
      (let* ((default-directory emacs-agent-data-directory)
             (run (emacs-agent-compact-test--history))
             (session (emacs-agent-run-session run))
             (first (emacs-agent-compact 1000 "retain constraints")))
        (emacs-agent-compact-test--complete first "FIRST-SUMMARY")
        ;; Public command lazily opens the checkpoint in a fresh registry too.
        (let* ((previous (copy-tree (emacs-agent-session-compaction session)))
               (emacs-agent-session--registry (make-hash-table :test #'equal))
               (job (emacs-agent-compact 0))
               (restored (emacs-agent-run-session (emacs-agent-compact-job-run job)))
               (view (copy-emacs-agent-run run)))
          (should-not (eq restored session))
          (emacs-agent-compact--callback job nil '(:error "provider failed"))
          (should (equal previous (emacs-agent-session-compaction restored)))
          (setf (emacs-agent-run-session view) restored)
          (should (string-match-p "FIRST-SUMMARY" (cadar (emacs-agent-gptel--history view)))))))))

(ert-deftest emacs-agent-compact-reentrant-start-cancel-and-terminal-fifo ()

(ert-deftest emacs-agent-compact-auto-before-http-one-attempt-and-budget-recheck ()
  (dolist (summary (list "SHORT-SUMMARY" (make-string 60000 ?z)))
    (emacs-agent-compact-test--fixture
      (with-temp-buffer
        (let* ((old (emacs-agent-test--submit (make-string 60000 ?x)))
               (session (emacs-agent-run-session old)))
          (emacs-agent-test--complete old "old done")
          (let* ((run (emacs-agent-test--submit "new task"))
                 (fsm (emacs-agent-f2-spike--dry-fsm run))
                 (gptel-use-curl t) wire)
            (cl-letf (((symbol-function 'gptel-curl-get-response)
                       (lambda (state) (setq wire (copy-tree (plist-get (gptel-fsm-info state) :data))))))
              (gptel--fsm-transition fsm 'WAIT)
              (should-not wire)
              (let ((job (emacs-agent-session-compaction-job session)))
                (should job)
                (should (eq (emacs-agent-compact-job-owner job) run))
                (emacs-agent-compact-test--complete job summary))
              (should-not (emacs-agent-session-compaction-job session))
              (should (emacs-agent-session-compaction session))
              (if (< (length summary) 100)
                  (progn
                    (should wire)
                    (should (string-match-p "SHORT-SUMMARY" (prin1-to-string wire)))
                    (should (eq (emacs-agent-session-active-run session) run)))
                (should-not wire)
                (should (eq (emacs-agent-run-status run) 'failed))))))))))

(ert-deftest emacs-agent-compact-disabled-auto-or-autosave-stops-before-http ()
  (dolist (disabled '(auto autosave))
    (emacs-agent-compact-test--fixture
      (with-temp-buffer
        (let ((old (emacs-agent-test--submit (make-string 60000 ?x))))
          (emacs-agent-test--complete old "old done")
          (let* ((run (emacs-agent-test--submit "next"))
                 (fsm (emacs-agent-f2-spike--dry-fsm run))
                 (emacs-agent-auto-save (not (eq disabled 'autosave)))
                 (gptel-use-curl t) wire)
            (when (eq disabled 'auto)
              (setf (emacs-agent-run-context-config run)
                    (plist-put (copy-sequence (emacs-agent-run-context-config run)) :automatic nil)))
            (cl-letf (((symbol-function 'gptel-curl-get-response) (lambda (_) (setq wire t))))
              (gptel--fsm-transition fsm 'WAIT))
            (should-not wire)
            (should (eq (emacs-agent-run-status run) 'failed))
            (should-not (emacs-agent-session-compaction (emacs-agent-run-session run)))))))))

(ert-deftest emacs-agent-compact-current-snapshots-and-paired-reasoning-survive-cut ()
  (emacs-agent-compact-test--fixture

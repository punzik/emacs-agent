;;; emacs-agent-compact-test.el --- Compaction lifecycle and wire regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-agent-compact)
;; Adapter, store, history and F2 seam fixtures load first.  No HTTP is sent.

(defmacro emacs-agent-compact-test--fixture (&rest body)
  (declare (indent 0) (debug t))
  `(emacs-agent-test-adapter
     (let ((emacs-agent-context-tokens 12000)
           (emacs-agent-context-reserve 1000)
           (emacs-agent-compaction-keep-recent 2000)
           (emacs-agent-auto-compact t)
           (emacs-agent-context-history nil)
           (emacs-agent-auto-save t))
       (unwind-protect (progn ,@body)
         (dolist (buffer (buffer-list))
           (when (string-prefix-p " *emacs-agent-summary*" (buffer-name buffer))
             (kill-buffer buffer)))))))

(defun emacs-agent-compact-test--complete (job text &optional reason)
  "Complete mocked JOB with TEXT and explicit provider stop REASON."
  (let* ((fsm (emacs-agent-compact-job-fsm job))
         (info (or (gptel-fsm-info fsm) (list :stop-reason nil))))
    (plist-put info :stop-reason (or reason "stop"))
    (setf (gptel-fsm-info fsm) info)
    (emacs-agent-compact--callback job text info)
    (gptel--fsm-transition fsm 'DONE)))

(defun emacs-agent-compact-test--history ()
  "Make two completed runs and return the most recent source run."
  (let ((old (emacs-agent-test--submit (concat "ORIGINAL-GOAL " (make-string 6000 ?x)))))
    (emacs-agent-test--complete old "old complete")
    (let ((new (emacs-agent-test--submit "recent goal")))
      (emacs-agent-test--complete new "recent answer")
      new)))

(ert-deftest emacs-agent-compact-manual-preserves-raw-history-and-persists-projection ()
  (emacs-agent-compact-test--fixture
    (with-temp-buffer
      (let* ((run (emacs-agent-compact-test--history))
             (session (emacs-agent-run-session run))
             (raw (copy-tree (emacs-agent-session-messages session)))
             (job (emacs-agent-compact-start run 1000 "preserve exact constraints"))
             (request (car emacs-agent-test--requests)))
        (should (string-match-p "Focus additionally on: preserve exact constraints" (plist-get request :system)))
        (should-not (plist-get request :stream))
        (should-not (emacs-agent-session-compaction session))
        (with-current-buffer (emacs-agent-compact-job-buffer job)
          (should-not gptel-use-tools)
          (should-not gptel-tools))
        (emacs-agent-compact-test--complete job "Original goal; old task done; continue recent goal.")
        (should (eq (emacs-agent-compact-job-state job) 'completed))
        (should-not (emacs-agent-session-compaction-job session))
        (should (equal raw (emacs-agent-session-messages session)))
        (should (= (plist-get (emacs-agent-session-compaction session) :cut) 2))
        (let ((history (emacs-agent-gptel--history run)))
          (should (string-match-p "<summary>" (cadar history)))
          (should (equal (cadr history) '(prompt "recent goal")))
          (should (equal (caddr history) '(response "recent answer"))))
        (let ((file (emacs-agent-store--file 'global)))
          (should (= (logand (file-modes file) #o777) #o600))
          (let ((emacs-agent-session--registry (make-hash-table :test #'equal)))
            (let ((restored (emacs-agent-store--restore file)))
              (should (equal (emacs-agent-session-compaction restored) (emacs-agent-session-compaction session)))
              (should (equal raw (emacs-agent-session-messages restored)))
              (should-not (emacs-agent-session-compaction-job restored)))))))))

(ert-deftest emacs-agent-compact-failure-empty-incomplete-and-cancel-keep-old-projection ()
  (dolist (failure '(empty length provider cancel tools))
    (emacs-agent-compact-test--fixture
      (with-temp-buffer
        (let* ((run (emacs-agent-compact-test--history))
               (session (emacs-agent-run-session run))
               (raw (copy-tree (emacs-agent-session-messages session)))
               (job (emacs-agent-compact-start run 0 nil)))
          (pcase failure
            ('empty (emacs-agent-compact-test--complete job "  \n"))
            ('length (emacs-agent-compact-test--complete job "partial summary" "length"))
            ('provider (emacs-agent-compact--callback job nil '(:error "offline failure")))
            ('cancel (emacs-agent-gptel-cancel session))
            ('tools (gptel--fsm-transition (emacs-agent-compact-job-fsm job) 'TOOL)))
          (should (memq (emacs-agent-compact-job-state job) '(failed cancelled)))
          (should-not (emacs-agent-session-compaction-job session))
          (should-not (emacs-agent-session-compaction session))
          (should (equal raw (emacs-agent-session-messages session)))
          ;; Late success cannot publish after cancellation/failure.
          (emacs-agent-compact-test--complete job "late summary")
          (should-not (emacs-agent-session-compaction session)))))))


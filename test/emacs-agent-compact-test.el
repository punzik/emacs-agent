(ert-deftest emacs-agent-compact-malformed-checkpoints-never-mutate-registry ()
  (emacs-agent-compact-test--fixture
    (with-temp-buffer
      (let* ((run (emacs-agent-compact-test--history))
             (session (emacs-agent-run-session run))
             (job (emacs-agent-compact-start run 0 nil)))
        (emacs-agent-compact-test--complete job "SUMMARY")
        (emacs-agent-test--submit "new active ask")
        (let* ((data (emacs-agent-store--snapshot session))
               (file (emacs-agent-store--file 'global)))
          (dolist (mutation '(cut summary unknown anchor config))
            (let ((bad (copy-tree data t)))
              (pcase mutation
                ('cut (plist-put (plist-get bad :compaction) :cut 999999))
                ('summary (plist-put (plist-get bad :compaction) :summary "  "))
                ('unknown (plist-put (plist-get bad :compaction) :unknown t))
                ('anchor (plist-put bad :usage-anchor
                                    '(:tokens 10 :estimate 10 :model "gpt-4o" :backend "agent-offline"
                                      :cut 999999 :source gptel-normalized)))
                ('config (plist-put (car (plist-get bad :runs)) :context-config
                                    '(:window 12000 :reserve 1 :keep 1 :keep 2))))
              (with-temp-buffer
                (emacs-agent-store--print bad)
                (write-region (point-min) (point-max) file nil 'silent))
              (should-error (emacs-agent-store--restore file))
              (should (eq (gethash 'global emacs-agent-session--registry) session)))))))))

(ert-deftest emacs-agent-compact-checkpoint-opens-without-gptel-installed ()
  (emacs-agent-compact-test--fixture
    (with-temp-buffer
      (let* ((run (emacs-agent-compact-test--history))
             (session (emacs-agent-run-session run))
             (job (emacs-agent-compact-start run 0 nil)))
        (emacs-agent-compact-test--complete job "OFFLINE-SUMMARY")
        (setf (emacs-agent-session-usage-anchor session)
              (list :tokens 50 :estimate 100 :model "gpt-4o" :backend "agent-offline"
                    :cut (plist-get (emacs-agent-session-compaction session) :cut)
                    :source 'gptel-normalized))
        (let* ((file (emacs-agent-store-save session))
               (library-directory (file-name-directory (locate-library "emacs-agent-store")))
               (form `(progn
                        (require 'emacs-agent-store)
                        (when (featurep 'gptel) (error "Unexpected gptel dependency"))
                        (let ((emacs-agent-data-directory ,emacs-agent-data-directory))
                          (let ((restored (emacs-agent-store--restore ,file)))
                            (unless (equal (plist-get (emacs-agent-session-compaction restored) :summary)
                                           "OFFLINE-SUMMARY")
                              (error "Lost summary"))
                            (unless (= (plist-get (emacs-agent-session-usage-anchor restored) :tokens) 50)
                              (error "Lost usage anchor"))
                            (when (or (featurep 'gptel) (emacs-agent-session-compaction-job restored))
                              (error "Unexpected transport restoration"))
                            (princ "offline-ok"))))))
          (with-temp-buffer
            (should (= 0 (call-process (expand-file-name invocation-name invocation-directory)
                                       nil (current-buffer) nil "-Q" "--batch" "-L" library-directory
                                       "--eval" (prin1-to-string form))))
            (should (string-match-p "offline-ok" (buffer-string)))))))))


(ert-deftest emacs-agent-compact-summary-wait-strips-tools-and-accounts-owner-http ()
  (emacs-agent-compact-test--fixture
    (with-temp-buffer
      (let* ((run (emacs-agent-compact-test--history))
             (job (emacs-agent-compact-start run 0 nil))
             (fsm (emacs-agent-compact-job-fsm job))
             wire)
        ;; Use a real request serializer but mock the transport below WAIT.
        (with-current-buffer (emacs-agent-compact-job-buffer job)
          (funcall emacs-agent-test--real-request "bounded transcript" :dry-run t :fsm fsm
                   :system emacs-agent-compaction-system-prompt :transforms '(ignore)))
        (let ((data (plist-get (gptel-fsm-info fsm) :data)))
          (plist-put data :tools [(:function (:name "eval_elisp"))])
          (plist-put data :tool_choice "required")
          (plist-put data :parallel_tool_calls t))
        (let ((gptel-use-curl t))
          (cl-letf (((symbol-function 'gptel-curl-get-response)
                     (lambda (state) (setq wire (copy-tree (plist-get (gptel-fsm-info state) :data))))))
            (gptel--fsm-transition fsm 'WAIT)))
        (should wire)
        (should-not (plist-member wire :tools))
        (should-not (plist-member wire :tool_choice))
        (should-not (plist-member wire :parallel_tool_calls))
        (should (= (length (emacs-agent-run-usage-requests (emacs-agent-compact-job-run job))) 1))
        (emacs-agent-compact-test--complete job "SAFE-SUMMARY")))))

(ert-deftest emacs-agent-compact-usage-anchor-persists-invalidates-and-calibrates ()

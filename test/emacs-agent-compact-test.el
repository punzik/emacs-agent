              (should (string-match-p "pair-2" text))
              (should (string-match-p "actual protocol reasoning" text))
              (should (= (emacs-agent-f2-spike--contexts (append (plist-get data :messages) nil))
                         (if (eq policy 'current) 1 0)))))
          (should (equal raw (emacs-agent-session-messages session))))))))


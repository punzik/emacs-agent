      (let* ((emacs-agent-context-history 'current)
             (run (emacs-agent-test--submit "original"))
             (session (emacs-agent-run-session run)))
        (emacs-agent-test--real-tools run)
        (let ((raw (copy-tree (emacs-agent-session-messages session))))
          ;; The normalized tool record is one atomic assistant-call/result pair.

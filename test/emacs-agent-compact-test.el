             (fsm (emacs-agent-f2-spike--dry-fsm run)))
        (setf (gptel-fsm-state fsm) 'TOOL)
        (plist-put (gptel-fsm-info fsm) :tokens '(:input 0 :cached 0 :output 10))
        (emacs-agent-compact-observe run fsm)
        (should-not (emacs-agent-session-usage-anchor session))
        (plist-put (gptel-fsm-info fsm) :tokens '(:input 10 :cached 30 :output 5))
        (emacs-agent-gptel--callback run "answer" (gptel-fsm-info fsm))
        (gptel--fsm-transition fsm 'DONE)
        (let* ((anchor (emacs-agent-session-usage-anchor session))
               (file (emacs-agent-store-save session)))
          (should (= (plist-get anchor :tokens) 45))
          (should (= (emacs-agent-compaction-estimate
                      (let ((data (copy-tree (plist-get (gptel-fsm-info fsm) :data) t)))
                        (plist-put data :messages
                                   (vconcat (plist-get data :messages) [(:role "assistant" :content "answer")]))
                        data) anchor) 45))
          (let ((emacs-agent-session--registry (make-hash-table :test #'equal)))
            (should (equal anchor (emacs-agent-session-usage-anchor (emacs-agent-store--restore file)))))
          (let ((gptel-model 'another))
            (emacs-agent-test--submit "model changed"))

                (list :cut 1 :summary "goal summary" :tokens-before 100
                      :model "gpt-4o" :backend "agent-offline" :time 1))
          (dolist (policy '(nil current full))
            (let* ((data (emacs-agent-test--wire run policy))
                   (text (prin1-to-string data)))
